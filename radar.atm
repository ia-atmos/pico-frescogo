;; The radar: the packets of the serial line, and the filter that turns
;; them into the hits (`radar_be` of the original, with the same behaviour).
;;
;; `radar()` reads one packet, waiting for it, and evaluates to:
;;      :silencio           nothing was detected
;;      :duvida             a reading that the filter does not accept
;;      :golpe [jog=, kmh=] a hit: the athlete (0=esq, 1=dir) and its speed,
;;                          ready to be emitted
;;
;; A packet has 23 bytes: 0x88, and then 22 characters, with the direction
;; in the bit 1 of the 8th one (0=the ball goes away from the radar, 1=it
;; comes), and the speed in the 9th to the 12th, in tenths of km/h.

val RADAR_OUT = os.getenv("FRESCOGO_RADAR") || "radar.txt"      ;; the log

func radar_out (msg) {
    pin f = io.open(RADAR_OUT, "a")
    io.write(f, msg, "\n")
}

func radar_clear () {
    serial.clear(RADAR)
}

;; The state of the filter, which lasts from a sequence to the next one.
;; `dir` is 0 (goes away), 1 (comes), or -1 (none).
pin R = [
    ;; the last `radar.reps` readings, the oldest first: a hit needs all of
    ;; them in the same direction
    leituras = [],
    ;; the last hit: the side that the next one is expected from (the other
    ;; one), and its time
    proximo  = -1,
    t        = 0,
    kmh      = 0,       ;; the speed of the last reading accepted, or 0
]
loop in CONF.radar.reps {
    vector.insert(R.leituras, [kmh=0, dir=0])
}

;;;
75 km/h = 20.8 m/s
20.8 m - 1000 ms
15.0 m -  721 ms
700ms sem repeticao é seguro
;;;

func seta (dir) {
    ifs {
        dir == 0 => "->"
        dir == 1 => "<-"
        else     => "--"
    }
}

func radar () {
    ;; about 40 to 50 packets per second (20 to 25 ms each)
    loop {
        until serial.byte(RADAR) == 0x88        ;; the first byte of a packet
    }
    val s = serial.bytes(RADAR, 22)

    val kmh = tonumber(string.sub(s, 8, 11)) || 0      ;; in tenths
    val dir = if kmh == 0 => -1 => ((string.byte(s, 7) >> 1) & 0x01)

    val agora = string.format("[%04d]", NOW // 100)
    if kmh != 0 {
        radar_out(string.format("%s %s %03d", agora, seta(dir), kmh))
    }

    ;; the readings: the newest in, the oldest out
    val nova = vector.insert(R.leituras, [kmh=kmh, dir=dir])
    vector.remove(R.leituras, 0)

    ;; a hit only when all the readings are in the same direction, with the
    ;; highest of their speeds
    if !iter.all(R.leituras, \{ it.dir == dir }) {
        return :duvida
    }
    val vel = iter.max(iter.map(R.leituras, \{ it.kmh }))

    ;; too soon after the last hit: `oposi` for a hit of the other side,
    ;; which is expected; `igual` for one of the same side
    val espera = if dir == R.proximo => CONF.radar.oposi => CONF.radar.igual
    if NOW < (R.t + espera) {
        return if vel == 0 => :silencio => :duvida
    }

    if (vel != 0) || (R.kmh != 0) {
        val msg = string.format(">>> %s %s %03d <<<", agora, seta(dir), vel)
        radar_out(msg)
        print(msg)
    }

    set R.kmh = vel
    if vel != 0 {
        set R.proximo = 1 - dir
        set R.t       = NOW
    }
    set nova.dir = -1       ;; the next hit needs new readings

    val v = (vel + 5) // 10     ;; rounded, in km/h
    ifs {
        v == 0 => :silencio
        v == 1 => :duvida
        else   => :golpe [jog=(if dir == 1 => (1 - CONF.radar.lado) => CONF.radar.lado), kmh=v]
    }
}
