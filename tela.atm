;; The screen of the scoreboard: panels, each a layer of pico, placed in the
;; window by percentages, as the original has them:
;;
;;      +-----------+---------+-----------+
;;      | logo1     | tempo   | logo2     |     0..2
;;      +-----------+         +-----------+
;;      | nome1     |         | nome2     |     2..3
;;      +-----------+---------+-----------+
;;      | meio                            |     3..5
;;      +-----------+---------+-----------+
;;      | atleta1   | total   | atleta2   |     5..8
;;      +-----------+---------+-----------+
;;           4           3          4           (11 columns, 8 rows)
;;
;; Each region of the screen is a task that draws into its panel, at each
;; picture of the screen (`:tela`), in fractions of the panel. The task of
;; the program, of a presentation, of a warm-up, or of a sequence spawns the
;; regions that are its own, which go away with it.

include "desenho.atm"

;; The whole screen; or a window of three quarters of the screen, with
;; `tela.cheia = false` (or `FRESCOGO_JANELA=1`).
pico.open [title="FrescoGO! " ++ VERSAO]
val cheia = CONF.tela.cheia && (os.getenv("FRESCOGO_JANELA") == nil)
do {
    val s = pico.get.app().screen
    if cheia {
        pico.set.dim ['!', w=s.w, h=s.h]
    } else {
        pico.set.dim ['!', w=s.w*3//4, h=s.h*3//4]
    }
}
pico.set.app [fullscreen=cheia]

pico.set.expert(true, 60)
pico.set.aids(false)            ;; the keys with CTRL are of the scoreboard

pico.set.effect [color=BRANCO]

val CINZA = cinza(150)

;; THE PANELS, by columns (of 11) and rows (of 8), and their colors.
func painel (c, l, w, h) {
    ['%', x=c/11, y=l/8, w=w/11, h=h/8, anchor=:NW]
}
pin P = [
    logo1   = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(0, 0, 4, 2)],
    tempo   = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(4, 0, 3, 3)],
    logo2   = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(7, 0, 4, 2)],
    nome1   = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(0, 2, 4, 1)],
    nome2   = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(7, 2, 4, 1)],
    meio    = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(0, 3, 11, 2)],
    atleta1 = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(0, 5, 4, 3)],
    total   = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(4, 5, 3, 3)],
    atleta2 = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(7, 5, 4, 3)],
    grade   = pico.layer.empty [up=pico.layer.world, clear=true, target=painel(0, 0, 11, 8)],
]
loop k, l in P {
    val old = pico.set.layer(l)
    pico.set.effect [color=ifs {
        X.in(k, ["tempo", "total"]) => PRETO
        k == "grade" => ['!', r=0, g=0, b=0, a=0]       ;; over all, transparent
        else => BRANCO
    }]
    fonte("data/LiberationSans-Bold.ttf")
    pico.set.layer(old)
}

;; The contexts of the panels: a region draws in its panel with
;; `in <:tela> C.<panel>, do {...}`.
pin C = []
loop k, l in P {
    set C@k = pico.ctx.layer(l)
}

pin IMG = [
    logos    = [ figura(CONF.tela.imagem1), figura(CONF.tela.imagem2) ],
    veloc    = figura("data/icos/speed-03.png"),
    golpes   = figura("data/icos/raq-03.png"),
    pontos   = figura("data/icos/flag.png"),
    apito    = figura("data/icos/apito-04.png"),
    trofeu   = figura("data/icos/trophy-02.png"),
    descanso = figura("data/icos/timeout-03.png"),
    radar    = [ sim = figura("data/icos/radar-verde.png",    255),
                 nao = figura("data/icos/radar-vermelho.png", 255) ],
]

;; One picture of the screen: the world and its panels are cleared, and the
;; regions draw.
func desenha () {
    pico.output.clear()
    emit @:global :tela
}

;; ----------------------------------------------------------------------------
;; THE REGIONS OF THE PROGRAM
;; ----------------------------------------------------------------------------

;; The lines between the white panels, over all of them.
task Grade () {
    in <:tela> C.grade, do {
        loop on :tela {
            traco_h(0,    4/11, 2/8, 2, PRETO)        ;; over the names
            traco_h(7/11, 1,    2/8, 2, PRETO)
            traco_h(0,    1,    3/8, 2, PRETO)        ;; around the middle
            traco_h(0,    1,    5/8, 2, PRETO)
            traco_v(4/11, 2/8,  3/8, 2, PRETO)        ;; at the sides of the names
            traco_v(7/11, 2/8,  3/8, 2, PRETO)
        }
    }
}

;; A logo.
task Logo (ctx, img) {
    in <:tela> ctx, do {
        loop on :tela {
            poe(img, 0.5, 0.5, 0.5)
        }
    }
}

;; The name of the athlete `jog()`, in blue; in red, with a cursor, while it
;; is typed.
task Rotulo (ctx, jog) {
    in <:tela> ctx, do {
        loop on :tela {
            val j = jog()
            if NOME == j {
                texto(NOMES@j ++ "_", 0.5, 0.5, 0.75, VERMELHO, :C)
            } else {
                texto(NOMES@j, 0.5, 0.5, 0.75, AZUL, :C)
            }
        }
    }
}

;; The radar at its side of the middle, in green, if there is one.
task Centro () {
    in <:tela> C.meio, do {
        loop on :tela {
            if RADAR != nil {
                poe(IMG.radar.sim, (if CONF.radar.lado == 0 => 0.035 => 0.965), 0.5, 0.3)
            }
        }
    }
}

;; The referee, at the top of the total.
task Arbitro () {
    in <:tela> C.total, do {
        loop on :tela {
            val nome = if NOME == 2 => (NOMES@2 ++ "_") => NOMES@2
            texto(nome, 0.5, 0.03, 0.055, (if NOME == 2 => VERMELHO => CINZA), :N)
            poe(IMG.apito, 0.5 - largura(nome, 0.055)/2 - 0.06, 0.055, 0.08)
        }
    }
}

;; ----------------------------------------------------------------------------
;; THE REGIONS OF A PRESENTATION, OR OF A WARM-UP
;; ----------------------------------------------------------------------------

;; The time that is left (`resta()`, in seconds), and the version; red at the
;; end (`fim`). The other parameters are in the report.
task Relogio (resta, fim) {
    val claro = if fim => BRANCO => CINZA
    in <:tela> C.tempo, do {
        loop on :tela {
            if fim {
                caixa(0, 0, 1, 1, VERMELHO)
            }
            val t = resta()
            texto(nf(t // 60, 2) ++ ":" ++ nf(t % 60, 2), 0.5, 0.42, 0.37, BRANCO, :C)
            texto("v" ++ VERSAO, 0.5, 0.0, 0.05, claro, :N)
        }
    }
}

;; The record: in red while `abaixo()`.
task Recorde (abaixo) {
    in <:tela> C.total, do {
        loop on :tela {
            val cor = if abaixo() => ['!', r=200, g=100, b=100] => CINZA
            texto(CONF.tela.recorde, 0.5, 0.29, 0.093, cor, :C)
            poe(IMG.trofeu, 0.5 - largura(CONF.tela.recorde, 0.093)/2 - 0.09, 0.29, 0.08)
        }
    }
}

;; The light of the automatic mode, by the referee: green when it is on, and
;; dark when it is off.
task Luz () {
    in <:tela> C.total, do {
        loop on :tela {
            disco(0.83, 0.067, 0.053, (if G.auto => ['!', r=0, g=150, b=0] => cinza(60)))
        }
    }
}

;; The speed of a hit, at one side of the middle: gray if it does not count.
func tela_ultima (esq, kmh) {
    if kmh == 0 {
        return
    }
    val x   = if esq => 0.136 => 0.864
    val cor = if kmh >= CONF.pontos.minima => PRETO => cinza(200)
    val h = 0.48                                ;; the number, centered
    texto(kmh,    x, 0.45,       h,      cor, :C)
    texto("km/h", x, 0.45 + h/2, h/4,    cor, :N)    ;; under it, a quarter of it
}

;; An arrow in the middle, from the side of who hit.
func tela_seta (esq) {
    val s = if esq => 1 => -1                   ;; it points to the middle
    val x = (if esq => 0.227 => 0.773) + s*larg(0.24)
    linha(x - s*larg(0.24), 0.5, x, 0.5, AZUL, 0.04)
    linha(x, 0.5, x - s*larg(0.06), 0.58, AZUL, 0.04)
    linha(x, 0.5, x - s*larg(0.06), 0.42, AZUL, 0.04)
}

;; The last hit of each athlete, of the hits `golpes`: its speed for
;; `tela.velocidade`, and an arrow for `tela.seta`.
task Ultimos (golpes) {
    in <:tela> C.meio, do {
        loop on :tela {
            var de = nil
            loop i in (1,2) {
                val golpe = golpes@(#golpes-i)
                if (golpe == nil) || (golpe.jog == de) {
                    skip            ;; the same athlete gave the last two hits
                }
                set de = golpe.jog
                val esq = (de == G.zer)
                if NOW <= (golpe.t + CONF.tela.velocidade) {
                    tela_ultima(esq, golpe.kmh)
                }
                if NOW <= (golpe.t + CONF.tela.seta) {
                    tela_seta(esq)
                }
            }
        }
    }
}

;; An arrow from the side of who hit, for `tela.seta`.
task Seta (esq) {
    val seta = CONF.tela.seta * 1ms
    watching seta {
        in <:tela> C.meio, do {
            loop on :tela {
                tela_seta(esq)
            }
        }
    }
}

;; ----------------------------------------------------------------------------
;; THE REGIONS OF A PRESENTATION
;; ----------------------------------------------------------------------------

;; The rest that is left, under the time: red when it ran out.
task Descanso (fim) {
    val claro = if fim => BRANCO => CINZA
    in <:tela> C.tempo, do {
        loop on :tela {
            val resta = descanso_resta()
            val cor   = if resta < 0 => VERMELHO => claro
            texto(math.abs(resta) ++ " s", 0.5, 0.83, 0.093, cor, :C)
            poe(IMG.descanso, 0.32, 0.83, 0.067)
            if resta < 0 {
                texto("(ESGOTADO)", 0.5, 0.92, 0.053, cor, :C)
            }
        }
    }
}

;; The falls, in the middle.
task Quedas () {
    in <:tela> C.meio, do {
        loop on :tela {
            disco(0.5, 0.5, 0.75, VERMELHO, PRETO)
            texto(jogo_quedas(), 0.5, 0.5, 0.5, BRANCO, :C)
        }
    }
}

;; The numbers of an athlete, in its panel: the hits and their limit, the
;; mean speed with the highest and the lowest at its outer side, and the
;; points. `esq` if the panel is at the left.
func tela_atleta (esq, jog) {
    val a = J.atletas@jog
    val m = if esq => 0.56 => 0.44             ;; the middle of the numbers

    val limite = conf_ataques(jog)
    texto(a.golpes, m, 0.17, 0.17, (if (limite > 0) && (a.golpes >= limite) => VERMELHO => PRETO), :C)
    texto("/" ++ limite, m + largura(a.golpes, 0.17)/2 + 0.02, 0.25, 0.053, CINZA, :SW)

    texto(a.media // 100, m, 0.5, 0.17, PRETO, :C)
    texto("." ++ nf(a.media % 100, 2), m + largura(a.media // 100, 0.17)/2, 0.56, 0.067, PRETO, :W)

    val xn = if esq => 0.9  => 0.1              ;; the numbers
    val xr = if esq => 0.81 => 0.19             ;; and their names
    texto(a.max, xn, 0.44, 0.08, CINZA, :C)
    texto(a.min, xn, 0.58, 0.08, CINZA, :C)
    texto("máx", xr, 0.44, 0.04, CINZA, :C)
    texto("min", xr, 0.58, 0.04, CINZA, :C)

    ;; red while the balance cuts the points of the other athlete
    val outro = (J.atletas@(1-jog)).pontos
    val corta = (CONF.pontos.equilibrio.limite != 0) && (outro > (a.pontos*CONF.pontos.equilibrio.limite // 100))
    texto(a.pontos, m, 0.83, 0.17, (if corta => VERMELHO => PRETO), :C)

    ;; what each row is
    val xi = if esq => 0.25 => 0.75
    poe(IMG.golpes, xi, 0.18, 0.13)
    poe(IMG.veloc,  xi, 0.51, 0.12)
    texto("km/h", xi, 0.57, 0.027, cinza(100), :C)
    poe(IMG.pontos, xi, 0.86, 0.11)
}

;; The two athletes, and the total of the presentation.
task Pontos () {
    in <:tela> C.atleta1, spawn {
        loop on :tela {
            tela_atleta(true, G.zer)
        }
    }
    in <:tela> C.atleta2, spawn {
        loop on :tela {
            tela_atleta(false, G.one)
        }
    }
    in <:tela> C.total, do {
        loop on :tela {
            texto(J.total, 0.5, 0.63, 0.37, BRANCO, :C)
            ;; how it is made: the points of each athlete, with the balance
            val ps = jogo_equ()
            texto("(" ++ ps@0 ++ " + " ++ ps@1 ++ ")", 0.5, 0.89, 0.04, CINZA, :C)
        }
    }
}

;; ----------------------------------------------------------------------------
;; THE REGIONS OF THE PRE-GAME, AND OF A WARM-UP
;; ----------------------------------------------------------------------------

;; A text in the middle.
task Aviso (txt) {
    in <:tela> C.meio, do {
        loop on :tela {
            texto(txt, 0.5, 0.5, 0.24, VERMELHO, :C)
        }
    }
}

;; No radar: a red radar that blinks at both sides, half of each second.
task SemRadar () {
    in <:tela> C.meio, do {
        loop {
            watching 500ms {
                loop on :tela {
                    loop _, x in [0.035, 0.965] {
                        poe(IMG.radar.nao, x, 0.5, 0.3)
                    }
                }
            }
            await 500ms
        }
    }
}

;; A text that blinks in the middle, half of each second.
task Pisca (txt) {
    loop {
        watching 500ms {
            await Aviso(txt)
        }
        await 500ms
    }
}
