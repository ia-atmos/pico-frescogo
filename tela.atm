;; The screen of the scoreboard: what the original draws, by regions. Each
;; region is drawn by a task, at each picture of the screen (`desenha`), in
;; two layers: `:tela.fundo` (the boxes, and what is always there) and then
;; `:tela.frente` (what is drawn on them). The task of the program, of a
;; presentation, of a warm-up, or of a sequence spawns the regions that are
;; its own, which go away with it.
;;
;;      +-----------+---------+-----------+
;;      |   logo    |  tempo  |   logo    |     0..2
;;      +-----------+descanso +-----------+
;;      |   nome    |         |   nome    |     2..3
;;      +-----------+---------+-----------+
;;      | última  -->  quedas    última   |     3..5
;;      +-----------+---------+-----------+
;;      |  golpes   | árbitro |  golpes   |     5..8
;;      |  média    | recorde |  média    |
;;      |  pontos   |  TOTAL  |  pontos   |
;;      +-----------+---------+-----------+
;;           4           3          4           (11 columns, 8 rows)

include "desenho.atm"

;; The whole screen, as the original has it; or a window of three quarters
;; of the screen, with `tela.cheia = false` (or `FRESCOGO_JANELA=1`).
pico.open [title="FrescoGO! " ++ VERSAO]
val cheia  = CONF.tela.cheia && (os.getenv("FRESCOGO_JANELA") == nil)
val width  = if cheia => pico.get.app().screen.w => (pico.get.app().screen.w * 3 // 4)
val height = if cheia => pico.get.app().screen.h => (pico.get.app().screen.h * 3 // 4)
pico.set.dim ['!', w=width, h=height]
pico.set.app [fullscreen=cheia]

pico.set.expert(true, 60)
pico.set.aids(false)            ;; the keys with CTRL are of the scoreboard

val W  = width  / 11.0          ;; a column
val H  = height /  8.0          ;; a row
val dx = 0.001 * width          ;; the sizes are thousandths of the screen
val dy = 0.001 * height
val MX = width / 2              ;; the middle

val CINZA = cinza(150)

fonte("data/LiberationSans-Bold.ttf")

pin IMG = [
    logos    = [ figura(CONF.tela.imagem1, height // 8), figura(CONF.tela.imagem2, height // 8) ],
    veloc    = figura("data/icos/speed-03.png",   math.floor(45*dy)),
    golpes   = figura("data/icos/raq-03.png",     math.floor(50*dy)),
    pontos   = figura("data/icos/flag.png",       math.floor(40*dy)),
    apito    = figura("data/icos/apito-04.png",   math.floor(30*dy)),
    trofeu   = figura("data/icos/trophy-02.png",  math.floor(30*dy)),
    descanso = figura("data/icos/timeout-03.png", math.floor(25*dy)),
    radar    = figura("data/icos/radar.png",      math.floor(30*dy)),
    raquete  = figura("data/icos/raq.png",        math.floor(40*dy)),
]

;; One picture of the screen.
func desenha () {
    fundo(BRANCO)
    emit @:global :tela.fundo
    emit @:global :tela.frente
}

;; ----------------------------------------------------------------------------
;; THE REGIONS OF THE PROGRAM
;; ----------------------------------------------------------------------------

;; The name of an athlete, in blue; in red, with a cursor, while it is typed.
func tela_nome (x, jog) {
    caixa(x, 2*H, 4*W, H, BRANCO, PRETO)
    if NOME == jog {
        texto(NOMES@jog ++ "_", x+2*W, 2.5*H-10*dy, 90*dy, VERMELHO, :meio)
    } else {
        texto(NOMES@jog, x+2*W, 2.5*H-10*dy, 90*dy, AZUL, :meio)
    }
}

;; What is always there: the logos, the names, the box of the middle with
;; the radar, and the box of the referee.
task Base () {
    loop on :tela.fundo {
        poe(IMG.logos@0, 2*W, H)
        poe(IMG.logos@1, 9*W, H)
        tela_nome(0*W, G.zer)
        tela_nome(7*W, G.one)

        caixa(0, 3*H, 11*W, 2*H-1, BRANCO, PRETO)
        if RADAR != nil {
            poe(IMG.radar, (if CONF.radar.lado == 0 => 20*dx => (width-20*dx)), 4*H)
        }

        caixa(4*W, 5*H, 3*W, 3*H, PRETO)
        val arbitro = if NOME == 2 => (NOMES@2 ++ "_") => NOMES@2
        texto(arbitro, MX, 5*H+12*dy, 20*dy, (if NOME == 2 => VERMELHO => CINZA), :topo)
        poe(IMG.apito, MX - largura(arbitro, 20*dy)/2 - 15*dx, 5*H+20*dy)
    }
}

;; ----------------------------------------------------------------------------
;; THE REGIONS OF A PRESENTATION, OR OF A WARM-UP
;; ----------------------------------------------------------------------------

;; The time that is left (`resta()`, in seconds), and the parameters; red at
;; the end (`fim`).
task Relogio (resta, fim) {
    val claro = if fim => BRANCO => CINZA
    loop on :tela.fundo {
        caixa(4*W, 0, 3*W, 3*H, (if fim => VERMELHO => PRETO))
        val t = resta()
        texto(nf(t // 60, 2) ++ ":" ++ nf(t % 60, 2), MX, 1.25*H-10*dy, 140*dy, BRANCO, :meio)
        texto("(" ++ conf_pars() ++ ")", MX, 0, 18*dy, claro, :topo)
        if G.inv {
            texto("inv", MX, 30*dy, 18*dy, claro, :topo)
        }
    }
}

;; The record: in red while `abaixo()`.
task Recorde (abaixo) {
    loop on :tela.frente {
        val cor = if abaixo() => ['!', r=200, g=100, b=100] => CINZA
        texto(CONF.tela.recorde, MX, 6*H-15*dy, 35*dy, cor, :meio)
        poe(IMG.trofeu, MX - largura(CONF.tela.recorde, 35*dy)/2 - 25*dx, 6*H-10*dy)
    }
}

;; A light by the referee: yellow in a warm-up, green in the automatic mode.
task Luz (cor, acesa) {
    loop on :tela.frente {
        if acesa() {
            disco(6.5*W, 5.2*H, 20*dy, cor)
        }
    }
}

;; The speed of a hit, at one side: gray if it does not count.
func tela_ultima (esq, kmh) {
    if kmh == 0 {
        return
    }
    val x   = if esq => 1.5*W => 9.5*W
    val cor = if kmh >= CONF.pontos.minima => PRETO => cinza(200)
    texto(kmh,    x, 4*H+45*dy, 120*dy, cor, :fundo)
    texto("km/h", x, 4*H+35*dy,  30*dy, cor, :topo)
}

;; An arrow from the side of who hit.
func tela_seta (esq) {
    val s = if esq => 1 => -1                   ;; it points to the middle
    val x = (if esq => 2.5*W => 8.5*W) + s*60*dy
    linha(x - s*60*dy, 4*H, x, 4*H, AZUL, 10*dy)
    linha(x, 4*H, x - s*15*dy, 4*H+20*dy, AZUL, 10*dy)
    linha(x, 4*H, x - s*15*dy, 4*H-20*dy, AZUL, 10*dy)
}

;; The last hit of each athlete, of the hits `golpes`: its speed for
;; `tela.velocidade`, and an arrow for `tela.seta`.
task Ultimos (golpes) {
    loop on :tela.frente {
        var de = nil
        loop i in (1,2) {
            val golpe = golpes@(#golpes-i)
            if (golpe == nil) || (golpe.jog == de) {
                skip            ;; the same athlete gave the last two hits
            }
            set de = golpe.jog
            val esq = (de == G.zer)
            if NOW <= (golpe.t + CONF.tela.velocidade) {
                tela_ultima(esq, golpe.kmh)
            }
            if NOW <= (golpe.t + CONF.tela.seta) {
                tela_seta(esq)
            }
        }
    }
}

;; ----------------------------------------------------------------------------
;; THE REGIONS OF A PRESENTATION
;; ----------------------------------------------------------------------------

;; The rest that is left, under the time: red when it ran out.
task Descanso (fim) {
    val claro = if fim => BRANCO => CINZA
    loop on :tela.frente {
        val resta = descanso_resta()
        val cor   = if resta < 0 => VERMELHO => claro
        texto(math.abs(resta) ++ " s", MX, 2.5*H, 35*dy, cor, :meio)
        poe(IMG.descanso, MX-50*dx, 2.5*H)
        if resta < 0 {
            texto("(ESGOTADO)", MX, 2.5*H+30*dy, 20*dy, cor, :meio)
        }
    }
}

;; The falls, in the middle, and the time that they took.
task Quedas () {
    loop on :tela.frente {
        disco(MX, height/2, 1.5*H, VERMELHO, PRETO)
        texto(jogo_quedas(), MX, height/2-15*dy, 110*dy, BRANCO, :meio)
        if jogo_desconto() > 0 {
            texto("-" ++ jogo_desconto() ++ " s", MX, height/2+60*dy, 22*dy, BRANCO, :meio)
        }
    }
}

;; The numbers of an athlete, in a column that starts at `x`: the hits and
;; their limit, the mean speed with the highest and the lowest at its outer
;; side, and the points.
func tela_atleta (esq, x, jog) {
    val a = J.atletas@jog
    val m = x + W                           ;; the middle of the column

    val limite = conf_ataques(jog)
    texto(a.golpes, m, 5.5*H, 65*dy, (if (limite > 0) && (a.golpes >= limite) => VERMELHO => PRETO), :meio)
    texto("/" ++ limite, m + largura(a.golpes, 20*dy) + 10*dx, 5.5*H+30*dy, 20*dy, CINZA, :esq)

    texto(a.media // 100, m, 6.5*H, 65*dy, PRETO, :meio)
    texto("." ++ nf(a.media % 100, 2), m+30*dx, 6.5*H+15*dy, 25*dy, PRETO, :meio)

    val xn = if esq => (x + 2*W + 30*dx) => (x - W/3)       ;; the numbers
    val xr = if esq => (x + 2*W) => (x - W/3 + 30*dx)       ;; and their names
    texto(a.max, xn, 6.5*H-H/6, 30*dy, CINZA, :meio)
    texto(a.min, xn, 6.5*H+H/4, 30*dy, CINZA, :meio)
    texto("máx", xr, 6.5*H-H/6, 15*dy, CINZA, :meio)
    texto("min", xr, 6.5*H+H/4, 15*dy, CINZA, :meio)

    ;; red while the balance cuts the points of the other athlete
    val outro = (J.atletas@(1-jog)).pontos
    val corta = (CONF.pontos.equilibrio.limite != 0) && (outro > (a.pontos*CONF.pontos.equilibrio.limite // 100))
    texto(a.pontos, m, 7.5*H, 65*dy, (if corta => VERMELHO => PRETO), :meio)

    ;; what each row is
    val xi = if esq => 1*W => 10*W
    poe(IMG.golpes, xi, 5.5*H+5*dy)
    poe(IMG.veloc,  xi, 6.5*H+5*dy)
    texto("km/h", xi, 6.5*H+25*dy, 10*dy, cinza(100), :meio)
    poe(IMG.pontos, xi, 7.5*H+10*dy)
}

;; The two athletes, and the total of the presentation.
task Pontos () {
    loop on :tela.frente {
        tela_atleta(true,  1.25*W, G.zer)
        tela_atleta(false, 7.75*W, G.one)

        texto(J.total, MX, 7*H-15*dy, 140*dy, BRANCO, :meio)
        ;; how it is made: the points of each athlete, with the balance
        val ps = jogo_equ()
        texto("(" ++ ps@0 ++ " + " ++ ps@1 ++ ")", MX, 7.5*H+20*dy, 15*dy, CINZA, :meio)
    }
}

;; ----------------------------------------------------------------------------
;; THE REGIONS OF A WARM-UP
;; ----------------------------------------------------------------------------

;; A text that blinks in the middle, half of each second.
task Pisca (txt) {
    loop {
        watching 500ms {
            loop on :tela.frente {
                texto(txt, MX, height/2, 60*dy, VERMELHO, :meio)
            }
        }
        await 500ms
    }
}
