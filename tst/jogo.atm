;; The test of the score: reads a script of `oracle/` from the standard
;; input, and prints what the oracle prints (see `oracle/README.md`).
;;
;;      tst/jogo.sh

include "../jogo.atm"

conf_load("data/conf.atm")

func conf (key, v) {
    val n = tonumber(v)
    match key {
        "trinca"     => set CONF_TRINCA     = (v == "true")
        "tempo"      => set CONF_TEMPO      = n
        "distancia"  => set CONF_DISTANCIA  = n
        "ataques"    => set CONF_ATAQUES    = n
        "equilibrio" => set CONF_EQUILIBRIO = n
        "minima"     => set CONF_VEL_MIN    = n
        "maxima"     => set CONF_VEL_MAX    = n
        "tregua"     => set CONF_TREGUA     = n
        "quedas"     => set CONF_QUEDAS     = n
        "aborta"     => set CONF_ABORTA     = n
        "saque"      => set CONF_SAQUE      = n
        "esquenta"   => set CONF_ESQUENTA   = n
        "descanso"   => set CONF_DESCANSO   = n
        "lado_radar" => set LADO_RADAR      = n - 1
        "lado_pivo"  => set LADO_PIVO       = n - 1
        else         => throw "conf : invalid key : " ++ key
    }
    if CONF_TRINCA {        ;; as `setup` does
        set CONF_EQUILIBRIO = 0
    }
}

func print_calc () {
    val ps = jogo_equ()
    io.write("calc" ++
        " tempo="  ++ JOGO_TEMPO_PASSADO ++ "," ++ JOGO_TEMPO_RESTANTE ++ "," ++ JOGO_TEMPO_RESTANTE_SHOW ++
        " total="  ++ JOGO_TOTAL ++
        " equ="    ++ ps@0 ++ "," ++ ps@1 ++
        " pct="    ++ jogo_quedas_pct() ++
        " aborta=" ++ conf_aborta() ++
        " jog0="   ++ vector.join(JOGO_JOGS@0, ",") ++ "/" ++ conf_ataques(0) ++
        " jog1="   ++ vector.join(JOGO_JOGS@1, ",") ++ "/" ++ conf_ataques(1) ++ "\n")
}

loop {
    val line = io.read()
    until line == nil
    val w = string.split(line)
    if (#w == 0) || (string.sub(w@0, 0, 0) == "#") {
        skip
    }
    match w@0 {
        "conf"     => conf(w@1, w@2)
        "radar"    => set RADAR = if w@1 == "1" => true => nil
        "esquenta" => {
            set ESQUENTA = (w@1 == "1")
            if #w > 2 {
                set ESQUENTA_INICIO = tonumber(w@2)
            }
        }
        "inicio"   => set JOGO_TEMPO_INICIO = tonumber(w@1)
        "estado"   => {
            set ESTADO = w@1
            if #w > 2 {
                set ESTADO_JOGANDO = w@2
            }
        }
        "now"      => set NOW = tonumber(w@1)
        "nome"     => set CONF_NOMES@(tonumber(w@1)) = w@2
        "seq"      => vector.insert(JOGO, [])
        "hit"      => vector.insert(JOGO@#, [tonumber(w@1), tonumber(w@2), tonumber(w@3)])
        "quedas"   => set JOGO_QUEDAS = tonumber(w@1)
        "manual"   => set JOGO_QUEDAS_MANUAL = tonumber(w@1)
        "descanso" => set JOGO_DESCANSO_TOTAL = tonumber(w@1)
        "calc"     => {
            jogo_calc()
            print_calc()
        }
        "report"   => {
            conf_pars()
            io.write(jogo_relatorio(w@1))
        }
        else       => throw "invalid command : " ++ w@0
    }
}
