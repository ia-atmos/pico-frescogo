;; The test of the score: reads a script of `oracle/` from the standard
;; input, and prints what the oracle prints (see `oracle/README.md`).
;;
;;      tst/jogo.sh

include "../jogo.atm"

conf_load("data/conf.atm")

;; A field of `conf.json`, as the original names it.
func conf (key, v) {
    ifs {
        key == "lado_radar"       => set CONF@key = tonumber(v) - 1
        CONF@key == nil           => throw "conf : invalid key : " ++ key
        else                      => set CONF@key = tonumber(v)
    }
}

;; The states, as the original names them (`ESTADO` and `ESTADO_JOGANDO`).
func estado (e, j) {
    set ESTADO = ifs {
        e == "terminado" => :fim
        e == "digitando" => :nome
        e != "jogando"   => :ocioso
        j == "jogando"   => :seq.golpes
        else             => :seq.saque
    }
}

func atleta (i) {
    val a = J.atletas@i
    a.pontos ++ "," ++ a.golpes ++ "," ++ a.media ++ "," ++ a.min ++ "," ++ a.max ++ "/" ++ conf_ataques(i)
}

func print_calc () {
    val ps = jogo_equ()
    io.write("calc" ++
        " tempo="  ++ J.passado ++ "," ++ J.restante ++ "," ++ J.mostra ++
        " total="  ++ J.total ++
        " equ="    ++ ps@0 ++ "," ++ ps@1 ++
        " desconto=" ++ jogo_desconto() ++
        " jog0="   ++ atleta(0) ++
        " jog1="   ++ atleta(1) ++ "\n")
}

var jogando = "sacando"     ;; `ESTADO_JOGANDO`, which lasts between states

loop {
    val line = io.read()
    until line == nil
    val w = string.split(line)
    if (#w == 0) || (string.sub(w@0, 0, 0) == "#") {
        skip
    }
    match w@0 {
        "conf"     => conf(w@1, w@2)
        "radar"    => set RADAR = if w@1 == "1" => true => nil
        "esquenta" => {
            set J.esquenta = (w@1 == "1")
            if #w > 2 {
                set J.saque = tonumber(w@2)
            }
        }
        "inicio"   => set J.inicio = tonumber(w@1)
        "estado"   => {
            set jogando = w@2 || jogando
            estado(w@1, jogando)
        }
        "now"      => set NOW = tonumber(w@1)
        "nome"     => set NOMES@(tonumber(w@1)) = w@2
        "seq"      => {
            vector.insert(J.seqs, [])
            vector.insert(J.cronos, [arbitro=false])
        }
        "crono"    => set J.cronos@(#J.cronos-1) = [t=tonumber(w@1), arbitro=true]
        "hit"      => {
            val t = tonumber(w@1)
            vector.insert(J.seqs@#, [t=t, jog=tonumber(w@2), kmh=tonumber(w@3)])
            val crono = J.cronos@(#J.cronos-1)
            if crono.t == nil {
                set crono.t = t     ;; the first hit starts the clock
            }
        }
        "quedas"   => set J.quedas = tonumber(w@1)
        "manual"   => set J.manual = tonumber(w@1)
        "descanso" => set J.descanso = tonumber(w@1)
        "calc"     => {
            jogo_calc()
            print_calc()
        }
        "report"   => io.write(jogo_relatorio(w@1))
        else       => throw "invalid command : " ++ w@0
    }
}
