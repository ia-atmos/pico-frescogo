;; FrescoGO! in Atmos, over pico.
;;
;; The port of `placar/placar.pde` (v4.1.0, the source of the release package), one to one with the
;; original first (see `PORT.md`). Built and run with `atmos-pico`:
;;
;;      make run
;;
;; For the tests, with no person (see `tst/`):
;;
;;      FRESCOGO_TRACE=1        prints each sound, with its time
;;      FRESCOGO_TS=<date>      the date of the names of the reports
;;      FRESCOGO_REL=<dir>      the directory of the reports
;;      FRESCOGO_CONF=<file>    another file of configuration

include "jogo.atm"

```:prelude
#include <sys/stat.h>
#include <time.h>

// The date as the original builds it from `year()`, ..., `second()`.
static const char* fresco_ts (void) {
    static char buf[32];
    time_t t = time(NULL);
    strftime(buf, sizeof(buf), "%Y_%m_%d_%H_%M_%S", localtime(&t));
    return buf;
}
```

val TRACE = os.getenv("FRESCOGO_TRACE") != nil
val REL   = os.getenv("FRESCOGO_REL") || "relatorios"

var RADAR_AUTO = false
val RADAR_AUTO_TIMEOUT = 3500
var RADAR_AUTO_INICIO = 0

val GOLPE_DELAY = 1500

var INV = false
var ZER = 0
var ONE = 1

;; THE CONFIGURATION, as `setup` reads it
val CONF = conf_load(os.getenv("FRESCOGO_CONF") || "data/conf.atm")

;; The size of the screen, as `fullScreen()` in the original.
pico.open [title="FrescoGO! " ++ VERSAO]
val width  = pico.get.app().screen.w
val height = pico.get.app().screen.h
pico.set.dim ['!', w=width, h=height]
pico.set.app [fullscreen=true]

val dy = 0.001 * height     ;; 0.001 height
val dx = 0.001 * width      ;; 0.001 width
val W  = width  / 11.0
val H  = height /  8.0

pico.set.expert(true, 60)       ;; the frame rate of Processing
pico.set.aids(false)            ;; the keys with CTRL are of the scoreboard

;; ----------------------------------------------------------------------------
;; TIME
;; ----------------------------------------------------------------------------

;; In a test with fixed frames (PICO_ATM_FRAMES=n:ms), the time is that of
;; the frames, and a delay only advances it. Otherwise it is the real time.
val TESTE = do {
    val v = os.getenv("PICO_ATM_FRAMES")
    (v != nil) && (string.split(v, ":")@1 != "0")
}

var MICROS = 0      ;; the time of the frames

func millis () {
    if TESTE => (MICROS // 1000) => pico.get.now()
}

;; `delay` of Processing: blocks everything, and the keys wait in the system.
func delay (ms) {
    if TESTE {
        set MICROS = MICROS + ms*1000
    } else {
        `SDL_Delay(a_dbl($ms));`
    }
}

func trace (msg) {
    if TRACE {
        print("[" ++ nf(millis(),6) ++ "] " ++ msg)
    }
}

;; ----------------------------------------------------------------------------
;; SOUNDS
;; ----------------------------------------------------------------------------

val SNDS_NOMES = ["fall.wav", "restart.wav", "30s.wav", "queda2.wav", "undo.wav", "start.wav"]
val HITS_NOMES = [
    "peteleco.mp3",         ;; 50--60
    "agudo.wav",            ;; 60--70
    "laser.wav",            ;; 70--80
    "hit.wav",              ;; 80--90
    "trophaser.wav",        ;; 90--100
    "ambulancia.wav",       ;; 100--
]

pin SNDS = []
pin HITS = []
loop _,nome in SNDS_NOMES {
    set SNDS@+ = pico.sound.load("data/snds/" ++ nome)
}
loop _,nome in HITS_NOMES {
    set HITS@+ = pico.sound.load("data/snds/" ++ nome)
}

func snds_play (i) {
    trace("snd " ++ SNDS_NOMES@i)
    pico.output.sound(SNDS@i)
}

func hits_play (i) {
    trace("snd " ++ HITS_NOMES@i)
    pico.output.sound(HITS@i)
}

func sound (kmh) {
    val kmh_ = math.abs(kmh)
    ifs {
        kmh_ < 50 => {
            if !conf_radar() {
                hits_play(0)
            }
        }
        kmh_ < 60  => hits_play(0)
        kmh_ < 70  => hits_play(1)
        kmh_ < 80  => hits_play(2)
        kmh_ < 90  => hits_play(3)
        kmh_ < 100 => hits_play(4)
        else       => hits_play(5)
    }
}

;; ----------------------------------------------------------------------------
;; THE FLOW
;; ----------------------------------------------------------------------------

func go_esquenta () {
    set ESTADO = "ocioso"
    vector.clear(JOGO)
    set JOGO_DESCANSO_TOTAL     = 0
    set JOGO_DESCANSO_PLAY      = false
    set JOGO_TEMPO_RESTANTE_OLD = conf_tempo()
    set JOGO_QUEDAS             = 0
    set JOGO_QUEDAS_MANUAL      = 0
    set JOGO_TEMPO_INICIO       = millis()
    snds_play(1)
}

func go_reinicio () {
    set ESTADO = "ocioso"
    vector.clear(JOGO)
    set JOGO_DESCANSO_TOTAL     = 0
    set JOGO_DESCANSO_PLAY      = false
    set JOGO_TEMPO_RESTANTE_OLD = conf_tempo()
    set JOGO_QUEDAS             = 0
    set JOGO_QUEDAS_MANUAL      = 0
    set JOGO_TEMPO_INICIO       = millis()
    snds_play(1)
}

func go_saque () {
    set ESTADO = "jogando"
    set ESTADO_JOGANDO = "sacando"
    set JOGO_DESCANSO_INICIO = millis()
    vector.insert(JOGO, [])
    snds_play(5)
    if RADAR != nil {
        radar_clear()
    }
    if ESQUENTA {
        set ESQUENTA_INICIO = NOW
    }
}

func go_queda () {
    if ESQUENTA {
        return
    }
    set ESTADO = "ocioso"
    set JOGO_QUEDAS = JOGO_QUEDAS + 1
    if jogo_quedas() >= conf_aborta() {
        delay(1000)
        go_termino()
    } else {
        snds_play(0)
        if RADAR_AUTO {
            delay(1000)
            go_saque()
        }
    }
}

;; A number of hundredths as `float(n)/100` is written in the original.
func f100 (n) {
    val d = n % 100
    (n // 100) ++ "." ++ ifs {
        d == 0      => "0"
        d % 10 == 0 => d // 10
        else        => nf(d,2)
    }
}

func go_termino () {
    set ESTADO = "terminado"
    snds_play(3)
    if JOGO_TOTAL > CONF_RECORDE {
        set CONF_RECORDE = JOGO_TOTAL
    }

    draw()

    if ESQUENTA {
        return
    }

    val ts = os.getenv("FRESCOGO_TS") || `:string fresco_ts()`
    `mkdir(A_STR_OF($REL)->s, 0777);`
    val nome = REL ++ "/frescogo-" ++ ts ++ "-" ++ CONF_NOMES@0 ++ "-" ++ CONF_NOMES@1

    ;; placar.png
    pico.output.screenshot(pico.layer.window, nome ++ "-placar.png")

    ;; placar.txt
    do {
        pin f = io.open(nome ++ ".txt", "w")
        io.write(f, jogo_relatorio(ts), "\n")      ;; `saveStrings` ends the line
    }

    ;; resultados.csv
    do {
        pin f = io.open(REL ++ "/resultados.csv", "a")
        if f == nil {
            print("Erro em 'resultados.csv'.")
            exit()
            return
        }
        val J0 = JOGO_JOGS@0
        val J1 = JOGO_JOGS@1
        io.write(f,
            ts ++ " ; " ++ JOGO_TOTAL ++ " ; " ++ jogo_quedas() ++ " ; " ++ (JOGO_DESCANSO_TOTAL // 1000) ++ " ; " ++
            CONF_NOMES@0 ++ " ; " ++ J0@0 ++ " ; " ++ J0@1 ++ " ; " ++ f100(J0@2) ++ " ; " ++
            CONF_NOMES@1 ++ " ; " ++ J1@0 ++ " ; " ++ J1@1 ++ " ; " ++ f100(J1@2) ++ " ; " ++
            "\n"
        )
    }
}

;; ----------------------------------------------------------------------------
;; THE RADAR (to be done: see the TODO)
;; ----------------------------------------------------------------------------

func radar_clear () {
}

func radar () {
    0
}

func exit () {
    pico.quit()
}

;; ----------------------------------------------------------------------------
;; KEYBOARD
;; ----------------------------------------------------------------------------

;; `key` and `keyCode` of Processing, from a key event of pico, which has
;; the name of the key as SDL gives it ('A', 'Left', 'Backspace') and the
;; modifiers. `keyCode` is the name. `key` is the code of the character, as
;; Java gives it: with CTRL, a letter is its control code (CTRL-H is 8, as
;; BACKSPACE), and a key with no character is CODED.

val BACKSPACE = 8
val ENTER     = 10
val RETURN    = 13
val ESC       = 27
val CODED     = 0xFFFF

var key     = 0
var keyCode = ""

func key_de (e) {
    val k = e.key
    ifs {
        (#k == 1) && (k >= "A") && (k <= "Z") => {
            val c = string.byte(k)
            ifs {
                e.ctrl            => c - 64
                e.shift != e.caps => c
                else              => c + 32
            }
        }
        (#k == 1) && (k >= "0") && (k <= "9") => string.byte(k)
        k == "-"            => if e.shift => string.byte("_") => string.byte("-")
        k == "="            => string.byte("=")
        k == "Backspace"    => BACKSPACE
        k == "Return"       => ENTER
        k == "Keypad Enter" => ENTER
        k == "Escape"       => ESC
        else                => CODED
    }
}

func letra (c) {
    ((c >= string.byte("a")) && (c <= string.byte("z"))) ||
    ((c >= string.byte("A")) && (c <= string.byte("Z"))) ||
    (c == string.byte("_"))
}

func trata_nome (idx, json) {
    ifs {
        (key == ENTER) || (key == RETURN) => {
            set CONF@json = CONF_NOMES@idx
            set ESTADO_DIGITANDO = 255
            set ESTADO = "ocioso"
        }
        key == BACKSPACE => {
            val nome = CONF_NOMES@idx
            if #nome > 0 {
                set CONF_NOMES@idx = string.sub(nome, 0, #nome-2)
            }
        }
        letra(key) => {
            set CONF_NOMES@idx = CONF_NOMES@idx ++ string.char(key)
        }
    }
}

func keyPressed (e) {
    val ctrl = e.ctrl

    if (key == ESC) && (!ctrl) {
        set key = 0
    }

    if ctrl {
        match keyCode {
            "Q" => set key = ESC                    ;; CTRL-Q
            "A" => {                                ;; CTRL-A
                set RADAR_AUTO = !RADAR_AUTO
                set RADAR_AUTO_INICIO = millis()
            }
            "E" => {                                ;; CTRL-E
                set ESQUENTA = true
                go_esquenta()
            }
            "-" => set JOGO_QUEDAS_MANUAL = JOGO_QUEDAS_MANUAL - 1
            "=" => set JOGO_QUEDAS_MANUAL = JOGO_QUEDAS_MANUAL + 1
            "R" => {                                ;; CTRL-R
                set ESQUENTA = false
                go_reinicio()
            }
            "S" => go_termino()                     ;; CTRL-S
            "I" => {                                ;; CTRL-I
                set INV = !INV
                set ZER = 1 - ZER
                set ONE = 1 - ONE
            }
        }
    }

    ifs {
        ctrl && (key == BACKSPACE) => {             ;; CTRL-BACKSPACE
            ifs {
                ESTADO == "ocioso" => {
                    if #JOGO > 0 {
                        set JOGO_QUEDAS = JOGO_QUEDAS - 1
                        vector.remove(JOGO)
                        snds_play(4)
                    }
                }
                (ESTADO == "jogando") && (ESTADO_JOGANDO == "sacando") => {
                    set ESTADO = "ocioso"
                    if #JOGO > 0 {
                        vector.remove(JOGO)
                        if #JOGO > 0 {
                            set JOGO_QUEDAS = JOGO_QUEDAS - 1
                            vector.remove(JOGO)
                            snds_play(4)
                        }
                    }
                }
            }
        }

        ESTADO == "ocioso" => {
            if ctrl {
                ifs {
                    keyCode == "0" => {             ;; CTRL-0
                        set ESTADO = "digitando"
                        set ESTADO_DIGITANDO = 2
                        set CONF_NOMES@2 = ""
                    }
                    keyCode == "1" => {             ;; CTRL-1
                        set ESTADO = "digitando"
                        set ESTADO_DIGITANDO = 0
                        set CONF_NOMES@0 = ""
                    }
                    keyCode == "2" => {             ;; CTRL-2
                        set ESTADO = "digitando"
                        set ESTADO_DIGITANDO = 1
                        set CONF_NOMES@1 = ""
                    }
                    (keyCode == "Up") || (keyCode == "U") => go_saque()     ;; CTRL-UP
                }
            }
        }

        ESTADO == "digitando" => {
            match ESTADO_DIGITANDO {
                0 => trata_nome(0, "atleta1")       ;; DIGITANDO ESQ
                1 => trata_nome(1, "atleta2")       ;; DIGITANDO DIR
                2 => trata_nome(2, "arbitro")       ;; DIGITANDO ARBITRO
            }
        }

        ESTADO == "jogando" => {
            ifs {
                ctrl && ((keyCode == "Down") || (keyCode == "J")) => {      ;; CTRL-DOWN
                    go_queda()
                }
                (keyCode == "Left") || (keyCode == "Right") => {            ;; LEFT/RIGHT
                    if ESTADO_JOGANDO == "sacando" {
                        set ESTADO_JOGANDO = "jogando"
                        set JOGO_DESCANSO_TOTAL = JOGO_DESCANSO_TOTAL + max(0, NOW-JOGO_DESCANSO_INICIO-5000)
                    }
                    val jog = if keyCode == "Left" => ZER => ONE
                    val seq = JOGO@#
                    vector.insert(seq, [NOW, jog, 0])   ;; golpe@2=0  -->  radar desligado
                    var kmh = 0
                    if #seq >= 2 {
                        set kmh = jogo_kmh(seq, #seq-2)
                    }
                    sound(kmh)
                }
            }
        }
    }
    jogo_calc()
}

;; ----------------------------------------------------------------------------
;; DRAW
;; ----------------------------------------------------------------------------

func draw () {
    set NOW = millis()

    if ESTADO == "jogando" {
        if conf_radar() {
            val kmh  = radar()
            val kmh_ = math.abs(kmh)
            if kmh_ > 1 {
                if (ESTADO_JOGANDO == "sacando") && (kmh_ >= CONF_SAQUE) {
                    set ESTADO_JOGANDO = "jogando"
                    set JOGO_DESCANSO_TOTAL = JOGO_DESCANSO_TOTAL + max(0, NOW-JOGO_DESCANSO_INICIO-5000)
                }
                if ESTADO_JOGANDO == "jogando" {
                    val jog = if kmh > 0 => LADO_RADAR => (1-LADO_RADAR)
                    vector.insert(JOGO@#, [NOW, jog, kmh_])     ;; golpe@2!=0  -->  radar ligado
                    sound(kmh)
                }
            }
            if RADAR_AUTO && (kmh != 0) {
                ;; zera o timeout com qq bola que não seja 0
                set RADAR_AUTO_INICIO = NOW
            }
        }
        if (ESTADO_JOGANDO == "jogando") &&
           RADAR_AUTO && (NOW >= (RADAR_AUTO_INICIO + RADAR_AUTO_TIMEOUT))
        {
            go_queda()
        }
        if (JOGO_TEMPO_RESTANTE_OLD > 30) && (JOGO_TEMPO_RESTANTE <= 30) {
            snds_play(2)
        }
        set JOGO_TEMPO_RESTANTE_OLD = JOGO_TEMPO_RESTANTE
        if JOGO_TEMPO_RESTANTE <= 0 {
            go_termino()
        }
    }

    jogo_calc()
    draw_draw()
}

func draw_logo (x, img) {
    pico.output.draw.image(img, ['!', x=x+2*W, y=H, h=height//8])
}

func draw_draw () {
    pico.set.effect [color='white']
    pico.output.clear()
    draw_logo(0*W, CONF.imagem1)
    draw_logo(7*W, CONF.imagem2)

    ;; TEMPO
    if !ESQUENTA {
        var descanso = JOGO_DESCANSO_TOTAL
        if (ESTADO == "jogando") && (ESTADO_JOGANDO == "sacando") {
            set descanso = descanso + max(0, NOW-JOGO_DESCANSO_INICIO-5000)
        }
        set descanso = descanso // 1000
        set descanso = CONF_DESCANSO - descanso
        if descanso < 0 {
            if !JOGO_DESCANSO_PLAY {
                set JOGO_DESCANSO_PLAY = true
                snds_play(2)
            }
        }
    }
}

;; ----------------------------------------------------------------------------
;; MAIN
;; ----------------------------------------------------------------------------

conf_pars()
go_reinicio()

spawn {
    loop dt on :clock {
        set MICROS = MICROS + dt
    }
}

;; As Processing does for a key that is pressed: `key`, `keyCode`, the
;; handler, and then ESC closes the program.
spawn {
    loop e on :key.dn {
        set key     = key_de(e)
        set keyCode = e.key
        keyPressed(e)
        if key == ESC {
            exit()
        }
    }
}

loop on :draw {
    draw()
}
