;; FrescoGO! in Atmos, over pico.
;;
;; The scoreboard of `placar/placar.pde` (v4.1.0), written for Atmos: the flow
;; of a presentation is a hierarchy of tasks, and each state is a place in
;; the code. Here with the changes of the rule since v4.1.0, which the branch
;; `4.1` does not have; the branch `fidelity` has the port that is one to one
;; with the original (see `PORT.md`). Built and run with `atmos-pico`:
;;
;;      make run
;;
;; For the tests, with no person (see `tst/`):
;;
;;      FRESCOGO_TRACE=1        prints each sound, with its time
;;      FRESCOGO_TS=<date>      the date of the names of the reports
;;      FRESCOGO_REL=<dir>      the directory of the reports
;;      FRESCOGO_CONF=<file>    another file of configuration
;;      FRESCOGO_RADAR=<file>   the file of the log of the radar (`radar.txt`)
;;      FRESCOGO_SERIAL=<path>  the port of the radar, instead of the one of
;;                              the configuration (a file of packets, or a
;;                              path that does not exist, for no radar)

include "jogo.atm"
include "serial.atm"

```:prelude
#include <sys/stat.h>
#include <time.h>

// The date as the original builds it from `year()`, ..., `second()`.
static const char* fresco_ts (void) {
    static char buf[32];
    time_t t = time(NULL);
    strftime(buf, sizeof(buf), "%Y_%m_%d_%H_%M_%S", localtime(&t));
    return buf;
}
```

val TRACE = os.getenv("FRESCOGO_TRACE") != nil
val REL   = os.getenv("FRESCOGO_REL") || "relatorios"

;; The state of the program, apart from the game (`J`, in `jogo.atm`).
pin G = [
    auto   = false,     ;; the automatic mode: a fall after a silence of the
    ultima = 0,         ;; radar, since this time (its last reading)
    inv    = false,     ;; the athletes changed sides
    zer    = 0,         ;; the side of the first athlete
    one    = 1,         ;; the side of the second one
    micros = 0,         ;; the time, in microseconds
]

conf_load(os.getenv("FRESCOGO_CONF") || "data/conf.atm")

;; ----------------------------------------------------------------------------
;; TIME
;; ----------------------------------------------------------------------------

;; `NOW` is the time since the start, in milliseconds, which the clock of
;; pico advances: once per frame, and also at the instant of each timer that
;; expires in between.

spawn {
    loop dt on :clock {
        set G.micros = G.micros + dt
        set NOW      = G.micros // 1000
    }
}

func trace (msg) {
    if TRACE {
        print("[" ++ nf(NOW,6) ++ "] " ++ msg)
    }
}

include "tela.atm"
include "radar.atm"

;; ----------------------------------------------------------------------------
;; SOUNDS
;; ----------------------------------------------------------------------------

pin SOM = []            ;; the sounds, by the names of their files
loop _,arq in CONF.som {
    if type(arq) == :string {
        set SOM@arq = pico.sound.load("data/snds/" ++ arq)
    }
}
loop _,g in CONF.som.golpes {
    set SOM@(g@1) = pico.sound.load("data/snds/" ++ g@1)
}

func toca (arq) {
    trace("snd " ++ arq)
    pico.output.sound(SOM@arq)
}

func som (nome) {
    toca(CONF.som@nome)
}

;; The sound of a hit, by its speed: none below `som.minima`.
func som_golpe (kmh) {
    if kmh < CONF.som.minima {
        return
    }
    loop _,g in CONF.som.golpes {
        if kmh < g@0 {
            toca(g@1)
            break
        }
    }
}

;; ----------------------------------------------------------------------------
;; KEYS
;; ----------------------------------------------------------------------------

;; CTRL with one of the given keys (the names of SDL).
func ctrl (e, k1, k2) {
    e.ctrl && ((e.key == k1) || (e.key == k2))
}

;; The character of a key in a name: a letter, or `_`.
func letra (e) {
    val k = e.key
    ifs {
        e.ctrl => nil
        (#k == 1) && (k >= "A") && (k <= "Z") => if e.shift != e.caps => k => string.lower(k)
        (k == "-") && e.shift => "_"
        else => nil
    }
}

;; ----------------------------------------------------------------------------
;; THE FLOW
;;
;;  Apresentacao        from a restart (CTRL-R, CTRL-E) to the next one
;;      Jogo            sequences, until the time is over (the falls take
;;                      time too)
;;          Saque       until the serve (CTRL-UP, or the automatic mode);
;;                      meanwhile, the referee undoes, edits names
;;              Nome    a name being typed
;;          Sequencia   from a serve to a fall
;;      the end         the report; CTRL-S ends at any moment, and saves again
;;
;; The events of a frame, in this order, are `:radar.vez` (the radar reads),
;; and `:quadro` (the conditions over the time are checked). The score is
;; computed again at the end of each frame, and after each key that changes
;; it: the conditions see what the last frame left.
;; ----------------------------------------------------------------------------

;; Discards the last sequence.
func remove_seq () {
    vector.remove(J.seqs)
    vector.remove(J.cronos)
}

;; Discards the last sequence, and the fall that ended it.
func desfaz () {
    if #J.seqs > 0 {
        set J.quedas = J.quedas - 1
        remove_seq()
        som(:desfaz)
    }
}

;; A name, typed until ENTER.
task Nome (idx) {
    set ESTADO = :nome
    set NOME   = idx
    set NOMES@idx = ""
    defer {
        set NOME = nil
    }
    loop {
        val e = await :key.dn
        val c = letra(e)
        ifs {
            (e.key == "Return") || (e.key == "Keypad Enter") => break
            (e.key == "Backspace") && (!e.ctrl) => {
                val nome = NOMES@idx
                set NOMES@idx = if #nome <= 1 => "" => string.sub(nome, 0, #nome-2)
            }
            c != nil => {
                set NOMES@idx = NOMES@idx ++ c
            }
        }
    }
}

;; Between sequences, until the serve. Evaluates to how it was served:
;; `:tecla` (the referee, CTRL-UP), `:auto` (the automatic mode, a while
;; after a fall, if `auto`), or nil (the falls that the referee added,
;; CTRL-=, took the time that was left).
task Saque (auto) {
    set ESTADO = :ocioso
    val ok, saque = watching :quadro until J.restante <= 0 {
        par :any {
            loop {
                set ESTADO = :ocioso
                val e = await :key.dn until (it.ctrl && X.in(it.key, ["Up", "U", "Backspace", "0", "1", "2"]))
                match e.key {
                    "Backspace" => {
                        desfaz()
                        jogo_calc()
                    }
                    "1"  => await Nome(0)
                    "2"  => await Nome(1)
                    "0"  => await Nome(2)
                    else => break
                }
            }
            :tecla
        } with {
            if !auto {
                await false
            }
            val resaque = CONF.radar.resaque * 1ms
            await resaque
            :auto
        }
    }
    if ok => saque => nil
}

;; A hit of the radar, in the sequence that goes on.
func golpe (seq, g) {
    vector.insert(seq, [t=NOW, jog=g.jog, kmh=g.kmh])
    som_golpe(g.kmh)
}

;; A sequence, from the serve on. Evaluates to how it ended: `:queda` (the
;; ball fell), `:tempo` (the time is over), or `:desfeita` (the referee
;; undid the serve). `tecla` if the referee served (CTRL-UP), and not the
;; automatic mode.
task Sequencia (tecla) {
    set ESTADO  = :seq.espera
    set J.saque = NOW
    val seq   = vector.insert(J.seqs, [])
    val crono = vector.insert(J.cronos, [arbitro=false])
    som(:saque)
    if RADAR != nil {
        radar_clear()
    }
    jogo_calc()

    ;; the hits of the radar: one reading per frame, only while the sequence
    ;; goes on
    spawn {
        if RADAR == nil {
            await false
        }
        loop on :radar.vez {
            val r = radar()
            if r != :silencio {
                set G.ultima = NOW      ;; a reading that is not silence
            }
            if type(r) == :table {
                emit r                  ;; :golpe [jog=, kmh=]
            }
        }
    }

    par :any {
        ;; the referee marks the fall (a warm-up has no falls)
        await :key.dn until ((!J.esquenta) && ctrl(it, "Down", "J"))
        :queda
    } with {
        await :quadro until J.restante <= 0
        :tempo
    } with {
        ;; THE SERVE: until the first hit, which the radar only takes with
        ;; the speed of a serve, or until the referee starts the clock in
        ;; spite of the radar (CTRL-UP again, once the key of the serve was
        ;; released: a key held repeats); before it, the referee may undo
        val g = par :any {
            await :key.dn until ctrl(it, "Backspace")
            :desfeita
        } with {
            if tecla {
                await :key.up until X.in(it.key, ["Up", "U"])
            }
            await :key.dn until ctrl(it, "Up", "U")
            :arbitro
        } with {
            await :golpe until it.kmh >= CONF.radar.saque
        }
        if g == :desfeita {
            set ESTADO = :ocioso
            remove_seq()              ;; this sequence, and the one before it
            desfaz()
            jogo_calc()
            :desfeita
        } else {
            ;; what the serve took beyond 5 seconds comes out of the rest
            set J.descanso = J.descanso + max(0, NOW - J.saque - (CONF.tempos.saque * 1000))
            set ESTADO  = :seq.golpes
            set crono.t = NOW
            if g == :arbitro {
                set crono.arbitro = true
                set G.ultima      = NOW     ;; the silence counts from here
                jogo_calc()
            } else {
                golpe(seq, g)
            }

            ;; THE HITS, until the fall
            par :any {
                loop h on :golpe {
                    golpe(seq, h)
                }
            } with {
                ;; in the automatic mode: 3.5 seconds with no reading
                await :quadro until ((!J.esquenta) && G.auto && (NOW >= (G.ultima + CONF.radar.silencio)))
                :queda
            }
        }
    }
}

;; The sequences of a presentation, until the time is over.
task Jogo () {
    var fim = nil
    loop {
        ;; after a fall, the automatic mode serves by itself
        val saque = await Saque(G.auto && (fim == :queda))
        until saque == nil
        set fim = await Sequencia(saque == :tecla)
        until fim == :tempo

        if fim == :queda {
            set ESTADO = :ocioso
            set J.quedas = J.quedas + 1
            jogo_calc()
            if J.restante <= 0 {        ;; the fall took the time that was left
                await 1s
                break
            }
            som(:queda)
        }
    }
}

;; The end of a presentation: the screen, and then its picture, the report,
;; and a line of `resultados.csv` (not for a warm-up).
func termina () {
    set ESTADO = :fim
    som(:fim)
    if J.total > CONF.tela.recorde {
        set CONF.tela.recorde = J.total
    }
    jogo_calc()
    tela()

    if J.esquenta {
        return
    }

    val ts = os.getenv("FRESCOGO_TS") || `:string fresco_ts()`
    `mkdir(A_STR_OF($REL)->s, 0777);`
    val nome = REL ++ "/frescogo-" ++ ts ++ "-" ++ NOMES@0 ++ "-" ++ NOMES@1

    pico.output.screenshot(pico.layer.window, nome ++ "-placar.png")

    do {
        pin f = io.open(nome ++ ".txt", "w")
        io.write(f, jogo_relatorio(ts), "\n")
    }

    do {
        pin f = io.open(REL ++ "/resultados.csv", "a")
        if f == nil {
            print("Erro em 'resultados.csv'.")
            pico.quit()
            return
        }
        io.write(f, jogo_csv(ts))
    }
}

;; A presentation, or a warm-up (the time runs, and there are no falls).
task Apresentacao (esquenta) {
    set J.esquenta = esquenta
    set J.descanso = 0
    set J.quedas   = 0
    set J.manual   = 0
    set J.inicio   = NOW
    vector.clear(J.seqs)
    vector.clear(J.cronos)
    set ESTADO = :ocioso
    jogo_calc()             ;; nothing is left of the last presentation
    som(:reinicio)

    ;; the warnings: `aviso` seconds left, each time a sequence crosses them, and
    ;; the rest that ran out
    spawn {
        loop {
            await :quadro until ((ESTADO ?? :seq) && (J.restante >  CONF.tempos.aviso))
            await :quadro until ((ESTADO ?? :seq) && (J.restante <= CONF.tempos.aviso))
            som(:aviso)
        }
    }
    spawn {
        if !J.esquenta {
            await :quadro until descanso_resta() < 0
            som(:aviso)
        }
    }

    ;; CTRL-S ends it at any moment
    watching :key.dn until ctrl(it, "S") {
        await Jogo()
    }

    ;; and saves it again, later
    loop {
        termina()
        await :key.dn until ctrl(it, "S")
    }
}

;; ----------------------------------------------------------------------------
;; MAIN
;; ----------------------------------------------------------------------------

;; The radar: the port of the configuration, or the last one of the system.
do {
    val porta = os.getenv("FRESCOGO_SERIAL") || (if CONF.radar.serial == "" => serial.last() => CONF.radar.serial)
    if porta != nil {
        set RADAR = serial.open(porta)
    }
    if RADAR == nil {
        print("Erro na comunicação com o radar:")
        print(porta || "(nenhuma porta serial)")
    } else {
        pin f = io.open(RADAR_OUT, "w")
    }
}

;; The presentations, one after the other: CTRL-R starts a new one, and
;; CTRL-E a warm-up, at any moment.
spawn {
    var esquenta = false
    loop {
        val _, e = watching :key.dn until ctrl(it, "R", "E") {
            await Apresentacao(esquenta)
        }
        set esquenta = (e.key == "E")
    }
}

;; The keys that are valid at any moment.
spawn {
    loop e on :key.dn until e.ctrl {
        val r = match e.key {
            "A" => {                                    ;; the automatic mode
                set G.auto   = !G.auto
                set G.ultima = NOW
            }
            "I" => {                                    ;; the athletes change sides
                set G.inv = !G.inv
                set G.zer = 1 - G.zer
                set G.one = 1 - G.one
            }
            "-"  => set J.manual = J.manual - 1
            "="  => set J.manual = J.manual + 1
            "Q"  => pico.quit()
            else => :nada
        }
        if r != :nada {
            jogo_calc()
        }
    }
}

;; A frame: the radar reads, the conditions over the time are checked, and
;; then the score and the screen.
loop on :draw {
    emit :radar.vez
    emit :quadro
    jogo_calc()
    tela()
}
