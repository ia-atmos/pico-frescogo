;; FrescoGO! in Atmos, over pico.
;;
;; The port of `placar/placar.pde` (v5.3.0, at `1d2edb8`), one to one with the
;; original first (see `README.md`). Built and run with `atmos-pico`:
;;
;;      make run

val MAJOR    = 5
val MINOR    = 3
val REVISION = 0
val VERSAO   = MAJOR ++ "." ++ MINOR ++ "." ++ REVISION

;; The directory of the images, fonts, and sounds is still the one of the
;; original sketch, while the original is kept beside the port.
val DIR = "placar/"

;; THE CONFIGURATION (`data/conf.atm`), as `setup` reads `conf.json`

val CONF = do {
    pin f = io.open("data/conf.atm")
    X.load(io.read(f, :all))
}

val CONF_TEMPO       = CONF.tempo           ;; 300s  = 5mins
val CONF_DISTANCIA   = CONF.distancia       ;; 750cm = 7.5m
val CONF_GOLPES      = CONF.golpes          ;; 60 golpes por minuto para a dupla
var CONF_EQUILIBRIO  = CONF.equilibrio      ;; 130=30% de diferenca maxima entre os atletas (0=desligado)
val CONF_VEL_MIN     = CONF.minima          ;; 50km/h menor velocidade contabilizada
val CONF_VEL_MAX     = CONF.maxima          ;; 85km/h maior velocidade contabilizada no modo manual
val CONF_MAXIMAS     = CONF.potentes        ;; 10=5 ataques de cada lado por minuto
var CONF_INTENSIDADE = CONF.continuos       ;; 10 golpes continuos
val CONF_SAQUE       = CONF.saque           ;; 45km/h menor velocidade que considera saque no modo autonomo
val CONF_TRINCA      = CONF.trinca
val CONF_TREGUA      = CONF.tregua
val CONF_QUEDAS      = CONF.quedas          ;; 2400 = 2.4s por queda para cada 60s - 12s/5min
val CONF_ESQUENTA    = CONF.esquenta
val CONF_DESCANSO    = CONF.descanso
val LADO_RADAR       = CONF.lado_radar - 1  ;; 0=esq, 1=dir
val LADO_PIVO        = CONF.lado_pivo  - 1  ;; 0=esq, 1=dir
val RADAR_REPS       = CONF.radar_reps
val RADAR_IGUAL      = CONF.radar_igual
val RADAR_OPOSI      = CONF.radar_oposi
var CONF_RECORDE     = CONF.recorde
val CONF_NOMES       = [ "Atleta 1", "Atleta 2", CONF.arbitro, CONF.prefixo ]   ;; 0=esq, 1=dir, 2=arb, 3=pre
val CONF_SERIAL      = CONF.serial          ;; ""=auto, "desligado", "/dev/ttyUSB0"

val RADAR_MOCK = false

if CONF_TRINCA {
    set CONF_EQUILIBRIO = 0
}

if RADAR_MOCK && CONF_INTENSIDADE!=0 {
    set CONF_INTENSIDADE = 4
}

;; The size of the screen, as `fullScreen()` in the original. pico gives no
;; size of the display yet: TEMPORARY, a native literal over SDL, until pico
;; has the query (see the TODO). It needs SDL, which `pico.open` initializes.
pico.open [title="FrescoGO! " ++ VERSAO]
val width  = `:number ({ SDL_DisplayMode m; SDL_GetCurrentDisplayMode(0,&m); m.w; })`
val height = `:number ({ SDL_DisplayMode m; SDL_GetCurrentDisplayMode(0,&m); m.h; })`

val dy = 0.001 * height     ;; 0.001 height
val dx = 0.001 * width      ;; 0.001 width
val W  = width  / 11.0
val H  = height /  8.0

pico.set.dim ['!', w=width, h=height]
pico.set.window [fullscreen=true]
pico.set.expert(true, 60)       ;; the frame rate of Processing

func draw_logo (x, img) {
    pico.output.draw.image(DIR ++ img, ['!', x=x+2*W, y=H, h=height//8])
}

func draw_jogo () {
    pico.set.effect [color='white']
    pico.output.clear()
    draw_logo(0*W, CONF.imagem1)
    draw_logo(7*W, CONF.imagem2)
}

loop on :draw {
    draw_jogo()
}
