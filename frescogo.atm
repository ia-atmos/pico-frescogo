;; FrescoGO! in Atmos, over pico.
;;
;; The port of `placar/placar.pde` (v4.1.0, the source of the release package), one to one with the
;; original first (see `PORT.md`). Built and run with `atmos-pico`:
;;
;;      make run
;;
;; For the tests, with no person (see `tst/`):
;;
;;      FRESCOGO_TRACE=1        prints the sounds and the transitions
;;      FRESCOGO_TS=<date>      the date of the names of the reports
;;      FRESCOGO_REL=<dir>      the directory of the reports
;;      FRESCOGO_CONF=<file>    another file of configuration

include "jogo.atm"

```:prelude
#include <sys/stat.h>
#include <time.h>

// The date as the original builds it from `year()`, ..., `second()`.
static const char* fresco_ts (void) {
    static char buf[32];
    time_t t = time(NULL);
    strftime(buf, sizeof(buf), "%Y_%m_%d_%H_%M_%S", localtime(&t));
    return buf;
}
```

val TRACE = os.getenv("FRESCOGO_TRACE") != nil
val REL   = os.getenv("FRESCOGO_REL") || "relatorios"

var RADAR_AUTO = false
val RADAR_AUTO_TIMEOUT = 3500
var RADAR_AUTO_INICIO = 0

val GOLPE_DELAY = 1500

var INV = false
var ZER = 0
var ONE = 1

;; THE CONFIGURATION, as `setup` reads it
val CONF = conf_load(os.getenv("FRESCOGO_CONF") || "data/conf.atm")

;; The size of the screen, as `fullScreen()` in the original.
pico.open [title="FrescoGO! " ++ VERSAO]
val width  = pico.get.app().screen.w
val height = pico.get.app().screen.h
pico.set.dim ['!', w=width, h=height]
pico.set.app [fullscreen=true]

val dy = 0.001 * height     ;; 0.001 height
val dx = 0.001 * width      ;; 0.001 width
val W  = width  / 11.0
val H  = height /  8.0

pico.set.expert(true, 60)       ;; the frame rate of Processing
pico.set.aids(false)            ;; the keys with CTRL are of the scoreboard

;; ----------------------------------------------------------------------------
;; TIME
;; ----------------------------------------------------------------------------

;; `millis()`: the time since the start, which the clock of pico advances.
var MICROS = 0
func millis () {
    MICROS // 1000
}

;; `delay(1000)` of `go_queda`: the original blocks for one second, and then
;; ends the presentation (the limit of falls) or serves (the automatic mode).
;; Here, the frames go on with nothing but the screen (`draw`), the keys wait
;; in `FILA`, and then `DELAY_O` tells what to do, and `DELAY_DE` who called
;; `go_queda`, to do the rest of it.
var DELAY    = nil      ;; the time when it ends, or nil
var DELAY_O  = nil      ;; :termino or :saque
var DELAY_DE = nil      ;; :draw or :key
pin FILA = []           ;; the keys that arrived meanwhile

func trace (msg) {
    if TRACE {
        print("[" ++ nf(millis(),6) ++ "] " ++ msg)
    }
}

;; ----------------------------------------------------------------------------
;; SOUNDS
;; ----------------------------------------------------------------------------

val SNDS_NOMES = ["fall.wav", "restart.wav", "30s.wav", "queda2.wav", "undo.wav", "start.wav"]
val HITS_NOMES = [
    "peteleco.mp3",         ;; 50--60
    "agudo.wav",            ;; 60--70
    "laser.wav",            ;; 70--80
    "hit.wav",              ;; 80--90
    "trophaser.wav",        ;; 90--100
    "ambulancia.wav",       ;; 100--
]

pin SNDS = []
pin HITS = []
loop _,nome in SNDS_NOMES {
    set SNDS@+ = pico.sound.load("data/snds/" ++ nome)
}
loop _,nome in HITS_NOMES {
    set HITS@+ = pico.sound.load("data/snds/" ++ nome)
}

func snds_play (i) {
    trace("snd " ++ SNDS_NOMES@i)
    pico.output.sound(SNDS@i)
}

func hits_play (i) {
    trace("hit " ++ HITS_NOMES@i)
    pico.output.sound(HITS@i)
}

func sound (kmh) {
    val kmh_ = math.abs(kmh)
    ifs {
        kmh_ < 50 => {
            if !conf_radar() {
                hits_play(0)
            }
        }
        kmh_ < 60  => hits_play(0)
        kmh_ < 70  => hits_play(1)
        kmh_ < 80  => hits_play(2)
        kmh_ < 90  => hits_play(3)
        kmh_ < 100 => hits_play(4)
        else       => hits_play(5)
    }
}

;; ----------------------------------------------------------------------------
;; THE FLOW
;; ----------------------------------------------------------------------------

func go_esquenta () {
    trace("go esquenta")
    set ESTADO = "ocioso"
    vector.clear(JOGO)
    set JOGO_DESCANSO_TOTAL     = 0
    set JOGO_DESCANSO_PLAY      = false
    set JOGO_TEMPO_RESTANTE_OLD = conf_tempo()
    set JOGO_QUEDAS             = 0
    set JOGO_QUEDAS_MANUAL      = 0
    set JOGO_TEMPO_INICIO       = millis()
    snds_play(1)
}

func go_reinicio () {
    trace("go reinicio")
    set ESTADO = "ocioso"
    vector.clear(JOGO)
    set JOGO_DESCANSO_TOTAL     = 0
    set JOGO_DESCANSO_PLAY      = false
    set JOGO_TEMPO_RESTANTE_OLD = conf_tempo()
    set JOGO_QUEDAS             = 0
    set JOGO_QUEDAS_MANUAL      = 0
    set JOGO_TEMPO_INICIO       = millis()
    snds_play(1)
}

func go_saque () {
    trace("go saque")
    set ESTADO = "jogando"
    set ESTADO_JOGANDO = "sacando"
    set JOGO_DESCANSO_INICIO = millis()
    vector.insert(JOGO, [])
    snds_play(5)
    if RADAR != nil {
        radar_clear()
    }
    if ESQUENTA {
        set ESQUENTA_INICIO = NOW
    }
}

;; `de` is who calls: :draw or :key (see `DELAY`).
func go_queda (de) {
    if ESQUENTA {
        return
    }
    trace("go queda")
    set ESTADO = "ocioso"
    set JOGO_QUEDAS = JOGO_QUEDAS + 1
    if jogo_quedas() >= conf_aborta() {
        ;; delay(1000) ; go_termino()
        set DELAY    = millis() + 1000
        set DELAY_O  = :termino
        set DELAY_DE = de
    } else {
        snds_play(0)
        if RADAR_AUTO {
            ;; delay(1000) ; go_saque()
            set DELAY    = millis() + 1000
            set DELAY_O  = :saque
            set DELAY_DE = de
        }
    }
}

;; A number of hundredths as `float(n)/100` is written in the original.
func f100 (n) {
    val d = n % 100
    (n // 100) ++ "." ++ ifs {
        d == 0      => "0"
        d % 10 == 0 => d // 10
        else        => nf(d,2)
    }
}

func go_termino () {
    trace("go termino")
    set ESTADO = "terminado"
    snds_play(3)
    if JOGO_TOTAL > CONF_RECORDE {
        set CONF_RECORDE = JOGO_TOTAL
    }

    draw()

    if ESQUENTA {
        return
    }

    val ts = os.getenv("FRESCOGO_TS") || `:string fresco_ts()`
    `mkdir(A_STR_OF($REL)->s, 0777);`
    val nome = REL ++ "/frescogo-" ++ ts ++ "-" ++ CONF_NOMES@0 ++ "-" ++ CONF_NOMES@1

    ;; placar.png
    pico.output.screenshot(pico.layer.window, nome ++ "-placar.png")

    ;; placar.txt
    do {
        pin f = io.open(nome ++ ".txt", "w")
        io.write(f, jogo_relatorio(ts), "\n")      ;; `saveStrings` ends the line
    }

    ;; resultados.csv
    do {
        pin f = io.open(REL ++ "/resultados.csv", "a")
        if f == nil {
            print("Erro em 'resultados.csv'.")
            exit()
            return
        }
        val J0 = JOGO_JOGS@0
        val J1 = JOGO_JOGS@1
        io.write(f,
            ts ++ " ; " ++ JOGO_TOTAL ++ " ; " ++ jogo_quedas() ++ " ; " ++ (JOGO_DESCANSO_TOTAL // 1000) ++ " ; " ++
            CONF_NOMES@0 ++ " ; " ++ J0@0 ++ " ; " ++ J0@1 ++ " ; " ++ f100(J0@2) ++ " ; " ++
            CONF_NOMES@1 ++ " ; " ++ J1@0 ++ " ; " ++ J1@1 ++ " ; " ++ f100(J1@2) ++ " ; " ++
            "\n"
        )
    }
}

;; ----------------------------------------------------------------------------
;; THE RADAR (to be done: see the TODO)
;; ----------------------------------------------------------------------------

func radar_clear () {
}

func radar () {
    0
}

func exit () {
    pico.quit()
}

;; ----------------------------------------------------------------------------
;; KEYBOARD
;; ----------------------------------------------------------------------------

;; A key event of pico has the name of the key (`key`, as SDL names it: 'A',
;; 'Left', 'Backspace') and the modifiers. `keyCode` of the original is the
;; name, and `key` is the character, which `key_char` builds.

func key_char (e) {
    val k = e.key
    ifs {
        (#k == 1) && (k >= "A") && (k <= "Z") => if e.shift != e.caps => k => string.lower(k)
        (k == "-") && e.shift => "_"
        else => nil
    }
}

func trata_nome (e, idx, campo) {
    val k = e.key
    ifs {
        (k == "Return") || (k == "Keypad Enter") => {
            set CONF@campo = CONF_NOMES@idx
            set ESTADO_DIGITANDO = 255
            set ESTADO = "ocioso"
        }
        k == "Backspace" => {
            val nome = CONF_NOMES@idx
            if #nome > 0 {
                set CONF_NOMES@idx = string.sub(nome, 0, #nome-2)
            }
        }
        else => {
            val c = key_char(e)
            if c != nil {
                set CONF_NOMES@idx = CONF_NOMES@idx ++ c
            }
        }
    }
}

func keyPressed (e) {
    val key  = e.key
    val ctrl = e.ctrl
    var quit = false

    if ctrl {
        match key {
            "Q" => set quit = true                  ;; CTRL-Q
            "A" => {                                ;; CTRL-A
                set RADAR_AUTO = !RADAR_AUTO
                set RADAR_AUTO_INICIO = millis()
            }
            "E" => {                                ;; CTRL-E
                set ESQUENTA = true
                go_esquenta()
            }
            "-" => set JOGO_QUEDAS_MANUAL = JOGO_QUEDAS_MANUAL - 1
            "=" => set JOGO_QUEDAS_MANUAL = JOGO_QUEDAS_MANUAL + 1
            "R" => {                                ;; CTRL-R
                set ESQUENTA = false
                go_reinicio()
            }
            "S" => go_termino()                     ;; CTRL-S
            "I" => {                                ;; CTRL-I
                set INV = !INV
                set ZER = 1 - ZER
                set ONE = 1 - ONE
            }
        }
    }

    ifs {
        ctrl && (key == "Backspace") => {           ;; CTRL-BACKSPACE
            ifs {
                ESTADO == "ocioso" => {
                    if #JOGO > 0 {
                        set JOGO_QUEDAS = JOGO_QUEDAS - 1
                        vector.remove(JOGO)
                        snds_play(4)
                    }
                }
                (ESTADO == "jogando") && (ESTADO_JOGANDO == "sacando") => {
                    set ESTADO = "ocioso"
                    if #JOGO > 0 {
                        vector.remove(JOGO)
                        if #JOGO > 0 {
                            set JOGO_QUEDAS = JOGO_QUEDAS - 1
                            vector.remove(JOGO)
                            snds_play(4)
                        }
                    }
                }
            }
        }

        ESTADO == "ocioso" => {
            if ctrl {
                ifs {
                    key == "0" => {                 ;; CTRL-0
                        set ESTADO = "digitando"
                        set ESTADO_DIGITANDO = 2
                        set CONF_NOMES@2 = ""
                    }
                    key == "1" => {                 ;; CTRL-1
                        set ESTADO = "digitando"
                        set ESTADO_DIGITANDO = 0
                        set CONF_NOMES@0 = ""
                    }
                    key == "2" => {                 ;; CTRL-2
                        set ESTADO = "digitando"
                        set ESTADO_DIGITANDO = 1
                        set CONF_NOMES@1 = ""
                    }
                    (key == "Up") || (key == "U") => go_saque()     ;; CTRL-UP
                }
            }
        }

        ESTADO == "digitando" => {
            match ESTADO_DIGITANDO {
                0 => trata_nome(e, 0, "atleta1")    ;; DIGITANDO ESQ
                1 => trata_nome(e, 1, "atleta2")    ;; DIGITANDO DIR
                2 => trata_nome(e, 2, "arbitro")    ;; DIGITANDO ARBITRO
            }
        }

        ESTADO == "jogando" => {
            ifs {
                ctrl && ((key == "Down") || (key == "J")) => {      ;; CTRL-DOWN
                    go_queda(:key)
                    if DELAY != nil {
                        return                      ;; resumes in `draw`
                    }
                }
                (key == "Left") || (key == "Right") => {            ;; LEFT/RIGHT
                    if ESTADO_JOGANDO == "sacando" {
                        set ESTADO_JOGANDO = "jogando"
                        set JOGO_DESCANSO_TOTAL = JOGO_DESCANSO_TOTAL + max(0, NOW-JOGO_DESCANSO_INICIO-5000)
                    }
                    val jog = if key == "Left" => ZER => ONE
                    val seq = JOGO@#
                    vector.insert(seq, [NOW, jog, 0])   ;; golpe@2=0  -->  radar desligado
                    var kmh = 0
                    if #seq >= 2 {
                        set kmh = jogo_kmh(seq, #seq-2)
                    }
                    sound(kmh)
                }
            }
        }
    }
    jogo_calc()

    if quit {
        exit()
    }
}

;; ----------------------------------------------------------------------------
;; DRAW
;; ----------------------------------------------------------------------------

func draw_logo (x, img) {
    pico.output.draw.image(img, ['!', x=x+2*W, y=H, h=height//8])
}

func draw_draw () {
    pico.set.effect [color='white']
    pico.output.clear()
    draw_logo(0*W, CONF.imagem1)
    draw_logo(7*W, CONF.imagem2)

    ;; TEMPO
    if !ESQUENTA {
        var descanso = JOGO_DESCANSO_TOTAL
        if (ESTADO == "jogando") && (ESTADO_JOGANDO == "sacando") {
            set descanso = descanso + max(0, NOW-JOGO_DESCANSO_INICIO-5000)
        }
        set descanso = descanso // 1000
        set descanso = CONF_DESCANSO - descanso
        if descanso < 0 {
            if !JOGO_DESCANSO_PLAY {
                set JOGO_DESCANSO_PLAY = true
                snds_play(2)
            }
        }
    }
}

;; The end of the branch of `draw` in which a presentation is going on.
func draw_jogando_fim () {
    if (JOGO_TEMPO_RESTANTE_OLD > 30) && (JOGO_TEMPO_RESTANTE <= 30) {
        snds_play(2)
    }
    set JOGO_TEMPO_RESTANTE_OLD = JOGO_TEMPO_RESTANTE
    if JOGO_TEMPO_RESTANTE <= 0 {
        go_termino()
    }
}

;; The end of `draw`.
func draw_fim () {
    jogo_calc()
    draw_draw()
}

func draw () {
    if DELAY != nil {
        if millis() < DELAY {
            draw_draw()
            return
        }
        ;; the `delay(1000)` of `go_queda` ended: what comes after it, and the
        ;; rest of who called `go_queda`
        val o  = DELAY_O
        val de = DELAY_DE
        set DELAY    = nil
        set DELAY_O  = nil
        set DELAY_DE = nil
        if o == :termino {
            go_termino()
        } else {
            go_saque()
        }
        if de == :draw {
            draw_jogando_fim()
            draw_fim()
            return
        }
        jogo_calc()         ;; the end of `keyPressed`
    }

    ;; the keys that waited for the delay
    loop {
        while (#FILA > 0) && (DELAY == nil)
        keyPressed(vector.remove(FILA, 0))
    }
    if DELAY != nil {
        draw_draw()
        return
    }

    set NOW = millis()

    if ESTADO == "jogando" {
        if conf_radar() {
            val kmh  = radar()
            val kmh_ = math.abs(kmh)
            if kmh_ > 1 {
                if (ESTADO_JOGANDO == "sacando") && (kmh_ >= CONF_SAQUE) {
                    set ESTADO_JOGANDO = "jogando"
                    set JOGO_DESCANSO_TOTAL = JOGO_DESCANSO_TOTAL + max(0, NOW-JOGO_DESCANSO_INICIO-5000)
                }
                if ESTADO_JOGANDO == "jogando" {
                    val jog = if kmh > 0 => LADO_RADAR => (1-LADO_RADAR)
                    vector.insert(JOGO@#, [NOW, jog, kmh_])     ;; golpe@2!=0  -->  radar ligado
                    sound(kmh)
                }
            }
            if RADAR_AUTO && (kmh != 0) {
                ;; zera o timeout com qq bola que não seja 0
                set RADAR_AUTO_INICIO = NOW
            }
        }
        if (ESTADO_JOGANDO == "jogando") &&
           RADAR_AUTO && (NOW >= (RADAR_AUTO_INICIO + RADAR_AUTO_TIMEOUT))
        {
            go_queda(:draw)
            if DELAY != nil {
                draw_draw()
                return          ;; resumes above
            }
        }
        draw_jogando_fim()
    }

    draw_fim()
}

;; ----------------------------------------------------------------------------
;; MAIN
;; ----------------------------------------------------------------------------

conf_pars()
go_reinicio()

spawn {
    loop dt on :clock {
        set MICROS = MICROS + dt
    }
}

spawn {
    loop e on :key.dn {
        val k = [key=e.key, ctrl=e.ctrl, shift=e.shift, caps=e.caps]
        if (DELAY != nil) || (#FILA > 0) {
            vector.insert(FILA, k)
        } else {
            keyPressed(k)
        }
    }
}

loop on :draw {
    draw()
}
