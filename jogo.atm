;; The configuration and the score of FrescoGO!, as `placar.pde` of v4.1.0
;; computes them.
;;
;; It does not depend on pico: `frescogo.atm` includes it, and so does the
;; test of the score (`tst/jogo.atm`), which compares it with the oracle.

val VERSAO = "4.1.0"

var NOW = 0             ;; the time, in milliseconds

;; THE CONFIGURATION: the table of `data/conf.atm` (see `conf_load`).
pin var CONF = []

;; THE STATE of the scoreboard, which the screen reads:
;;
;;      :ocioso         between sequences
;;      :nome           a name is being typed (`NOME` tells which)
;;      :seq.saque      a sequence: served, with no hit yet
;;      :seq.golpes     a sequence: the hits
;;      :fim            the presentation ended
;;
;; `ESTADO ?? :seq` holds in a sequence, in any of its two parts.
var ESTADO = :ocioso
var NOME   = nil        ;; 0=esq, 1=dir, 2=arbitro

pin NOMES = [ "Atleta 1", "Atleta 2", "" ]      ;; 0=esq, 1=dir, 2=arbitro

var RADAR = nil         ;; the serial line of the radar, or nil

;; THE GAME: what happened in a presentation, and what `jogo_calc` computes
;; from it.
pin J = [
    esquenta = false,   ;; a warm-up: the time runs, and there are no falls
    seqs     = [],      ;; the sequences: vectors of hits [t=, jog=, kmh=]
    quedas   = 0,       ;; the falls
    manual   = 0,       ;; the falls that the referee added or removed
    descanso = 0,       ;; the rest that was used, in ms
    inicio   = 0,       ;; the time of the start
    saque    = 0,       ;; the time of the last serve

    ;; computed:
    passado  = 0,       ;; the time played, in seconds
    restante = 0,       ;; the time left
    mostra   = 0,       ;; the time left to show, which runs between hits
    total    = 0,       ;; the points of the presentation
    atletas  = [        ;; of each athlete, by its side (0=esq, 1=dir)
        [pontos=0, golpes=0, media=0, min=0, max=0],
        [pontos=0, golpes=0, media=0, min=0, max=0],
    ],
]

val min = math.min
val max = math.max

;; The number of characters of a string, as `String.length` (the strings
;; are UTF-8 here: the bytes that continue a character do not count).
func len (str) {
    var n = 0
    loop i in #str {
        val c = string.byte(str, i)
        if (c < 0x80) || (c >= 0xC0) {
            set n = n + 1
        }
    }
    n
}

;; `str` with spaces up to `n` characters.
func ns (str, n) {
    str ++ string.rep(" ", max(0, n - len(str)))
}

;; `n` with at least `digits` digits, with zeros.
func nf (n, digits) {
    if n < 0 {
        "-" ++ nf(-n, digits)
    } else {
        val s = tostring(n)
        string.rep("0", max(0, digits - #s)) ++ s
    }
}

;; A number of hundredths as a decimal number, with one digit at least
;; (`float(n)/100` of Java, as a string).
func f100 (n) {
    val d = n % 100
    (n // 100) ++ "." ++ ifs {
        d == 0      => "0"
        d % 10 == 0 => d // 10
        else        => nf(d,2)
    }
}

;; ----------------------------------------------------------------------------
;; THE CONFIGURATION
;; ----------------------------------------------------------------------------

;; Reads the table of the configuration. The sides become 0=esq, 1=dir.
func conf_load (path) {
    set CONF = do {
        pin f = io.open(path)
        X.load(io.read(f, :all))
    }
    set CONF.lado_radar = CONF.lado_radar - 1
    set NOMES@2 = CONF.arbitro
}

;; The parameters of a presentation, as the screen and the report show them.
func conf_pars () {
    "v" ++ VERSAO ++ " / " ++
    "dupla" ++ " / " ++
    (if RADAR != nil => "radar" => (CONF.distancia ++ "cm")) ++ " / " ++
    CONF.tempo ++ "s"
}

func conf_tempo () {
    if J.esquenta => CONF.esquenta => CONF.tempo
}

;; The hits of an athlete that count, at most.
func conf_ataques (jog) {
    max(1, conf_tempo() * CONF.ataques // 60 // 2)
}

;; The falls that cost nothing: one per minute.
func conf_quedas_base () {
    CONF.tregua * conf_tempo() // 60
}

;; What each fall costs after them, in hundredths of percent.
func conf_quedas_pena () {
    CONF.quedas * 60 // conf_tempo()
}

;; The falls that end a presentation: one for each 15 seconds.
func conf_aborta () {
    conf_tempo() // CONF.aborta
}

;; ----------------------------------------------------------------------------
;; THE SCORE
;; ----------------------------------------------------------------------------

;; The speed of the hit `i` of a sequence: that of the radar, or, with no
;; radar, the distance over the time until the next hit (0 for the last one).
;; Two hits at the same instant give the highest speed that is accepted (the
;; original divides by zero there).
func jogo_kmh (seq, i) {
    val cur = seq@i
    ifs {
        cur.kmh != 0 => cur.kmh
        #seq < (i+2) => 0
        else => {
            val dt = (seq@(i+1)).t - cur.t
            if dt <= 0 => CONF.maxima => min(CONF.maxima, 36 * CONF.distancia // dt)
        }
    }
}

func jogo_quedas () {
    J.quedas + J.manual
}

;; What the falls take from the points, in hundredths of percent.
func jogo_quedas_pct () {
    max(0, jogo_quedas()-conf_quedas_base()) * conf_quedas_pena()
}

;; The rest that is left, in seconds: what the athletes took to serve, beyond
;; 5 seconds each time, is taken from `descanso`. Negative when it ran out.
func descanso_resta () {
    var ms = J.descanso
    if ESTADO == :seq.saque {
        set ms = ms + max(0, NOW-J.saque-5000)
    }
    CONF.descanso - (ms // 1000)
}

;; The points of the two athletes with the balance: from 30 hits on, none
;; has more than a percentage of the other.
func jogo_equ () {
    val a0 = J.atletas@0
    val a1 = J.atletas@1
    var p0 = a0.pontos
    var p1 = a1.pontos
    if (CONF.equilibrio != 0) && ((a0.golpes + a1.golpes) >= 30) {
        set p0 = min(p0, p1*CONF.equilibrio // 100)
        set p1 = min(p1, p0*CONF.equilibrio // 100)
    }
    [p0, p1]
}

;; The time played is the time of the sequences, each from its first hit to
;; its last one. In a warm-up, it is the time since the serve.
func _jogo_tempo () {
    var ms   = 0
    var last = NOW

    if J.esquenta {
        if ESTADO != :ocioso {
            set ms = NOW - J.saque
        }
    } else {
        loop _,seq in J.seqs {
            if #seq > 0 {
                set last = (seq@#).t
                set ms   = ms + (last - (seq@0).t)
            }
        }
    }

    set J.passado  = ms // 1000
    set J.restante = max(0, conf_tempo()-J.passado)
    set J.mostra   = J.restante

    if ESTADO == :seq.golpes {
        set J.mostra = J.mostra - ((NOW - last) // 1000)
    }
}

;; The numbers of an athlete: its strongest hits count, by `kmh*kmh/50`; the
;; last hit of each sequence, which made the ball fall, does not.
func _jogo_lado (jog) {
    val kmhs = []
    loop _,seq in J.seqs {
        loop j in (#seq - 1) {
            if (seq@j).jog == jog {
                val kmh = jogo_kmh(seq,j)
                if kmh >= CONF.minima {
                    vector.insert(kmhs, kmh)
                }
            }
        }
    }
    vector.sort(kmhs, \(a,b) { a > b })

    val N = min(conf_ataques(jog), #kmhs)
    var soma   = 0
    var pontos = 0
    loop i in N {
        set soma   = soma + kmhs@i
        set pontos = pontos + (kmhs@i * kmhs@i // 50)
    }

    val a = J.atletas@jog
    set a.pontos = pontos
    set a.golpes = #kmhs
    set a.media  = soma * 100 // max(1,N)       ;; in hundredths
    set a.min    = if N == 0 => 0 => kmhs@(N-1)
    set a.max    = if N == 0 => 0 => kmhs@0
}

func jogo_calc () {
    _jogo_tempo()
    _jogo_lado(0)
    _jogo_lado(1)

    val ps = jogo_equ()
    set J.total = (ps@0+ps@1) * (10000-jogo_quedas_pct()) // 10000
}

;; ----------------------------------------------------------------------------
;; THE REPORT
;; ----------------------------------------------------------------------------

;; The text of the report of a presentation, with the date `ts`.
func jogo_relatorio (ts) {
    val manual = ifs {
        J.manual == 0 => ""
        J.manual  > 0 => " (" ++ J.quedas ++ "+" ++ J.manual ++ ")"
        else          => " (" ++ J.quedas ++ J.manual ++ ")"
    }

    var atletas = ""
    loop i,a in J.atletas {
        set atletas = atletas ++
            ns(NOMES@i ++ ":",15) ++ nf(a.pontos,5) ++ " pontos / " ++
            nf(a.golpes,3) ++ " golpes / " ++
            nf(a.media // 100,2) ++ "." ++ nf(a.media % 100,2) ++ " km/h\n"
    }

    val ps      = jogo_equ()
    val parcial = (J.atletas@0).pontos + (J.atletas@1).pontos
    val equ     = ps@0 + ps@1

    var out = ns("Data:",          15) ++ ts ++ "\n" ++
              ns("Versão:",        15) ++ conf_pars() ++ "\n" ++
              "\n" ++
              ns("Descanso:",      15) ++ (J.descanso // 1000) ++ "\n" ++
              ns("Quedas:",        15) ++ jogo_quedas() ++ manual ++ "\n" ++
              "\n" ++
              atletas ++
              "\n" ++
              ns("Parcial:",       15) ++ nf(parcial,5) ++ " pontos\n" ++
              ns("Desequilibrio:", 15) ++ nf(parcial - equ, 5) ++ " (-)\n" ++
              ns("Quedas:",        15) ++ nf(equ - J.total, 5) ++ " (-)\n" ++
              "\n" ++
              ns("FINAL:",         15) ++ nf(J.total,5) ++ " pontos\n" ++
              "\n"

    loop i,seq in J.seqs {
        set out = out ++ "SEQUÊNCIA " ++ nf(i+1,2) ++ "\n============\n\nTEMPO   DIR   KMH\n-----   ---   ---\n"
        loop j,golpe in seq {
            set out = out ++ nf(golpe.t - J.inicio, 6) ++ "   " ++
                      (if golpe.jog == 0 => "->" => "<-") ++ "   " ++
                      nf(jogo_kmh(seq,j),3) ++ "\n"
        }
        set out = out ++ "\n\n"
    }
    out
}

;; The line of a presentation in `resultados.csv`.
func jogo_csv (ts) {
    var out = ts ++ " ; " ++ J.total ++ " ; " ++ jogo_quedas() ++ " ; " ++ (J.descanso // 1000) ++ " ; "
    loop i,a in J.atletas {
        set out = out ++ NOMES@i ++ " ; " ++ a.pontos ++ " ; " ++ a.golpes ++ " ; " ++ f100(a.media) ++ " ; "
    }
    out ++ "\n"
}
