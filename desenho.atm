;; The drawing that the screen uses, over pico: boxes, discs, lines, text,
;; and images, each with all that it needs as arguments. The positions and
;; the sizes are fractions of the current layer (a panel of the screen): x
;; and widths of its width, y and heights of its height.
;;
;; The images are drawn at half opacity, unless told otherwise.

val BRANCO   = ['!', r=255, g=255, b=255]
val PRETO    = ['!', r=0,   g=0,   b=0]
val VERMELHO = ['!', r=255, g=0,   b=0]
val AZUL     = ['!', r=0,   g=0,   b=255]

func cinza (v) {
    ['!', r=v, g=v, b=v]
}

;; A height of the current layer as a width: for what must be round, or
;; keep the proportion of the screen.
func larg (h) {
    val d = pico.get.scene().dim
    h * d.h / d.w
}

;; A box from its top left corner.
func caixa (x, y, w, h, cor) {
    pico.set.pencil [color=cor, shape=[style=:fill]]
    pico.output.draw.rect ['%', x=x, y=y, w=w, h=h, anchor=:NW]
}

;; A horizontal line from x1 to x2, and a vertical one from y1 to y2, of
;; `px` pixels, centered on the given position.
func traco_h (x1, x2, y, px, cor) {
    val d = pico.get.scene().dim
    caixa(x1, y - (px/2)/d.h, x2 - x1, px/d.h, cor)
}
func traco_v (x, y1, y2, px, cor) {
    val d = pico.get.scene().dim
    caixa(x - (px/2)/d.w, y1, px/d.w, y2 - y1, cor)
}

;; A disc from its center, of diameter `d` (a height), with an optional
;; border.
func disco (x, y, d, cor, borda) {
    pin r = ['%', x=x, y=y, w=larg(d), h=d, anchor=:C]
    pico.set.pencil [color=cor, shape=[style=:fill]]
    pico.output.draw.oval(r)
    if borda != nil {
        pico.set.pencil [color=borda, shape=[style=:stroke]]
        pico.output.draw.oval(r)
    }
}

;; A thick line, with round ends; `peso` is a height.
func linha (x1, y1, x2, y2, cor, peso) {
    val d  = pico.get.scene().dim
    val px1 = x1 * d.w
    val py1 = y1 * d.h
    val px2 = x2 * d.w
    val py2 = y2 * d.h
    val p  = peso * d.h
    val vx = px2 - px1
    val vy = py2 - py1
    val n  = math.sqrt(vx*vx + vy*vy)
    val nx = (-vy / n) * (p / 2)
    val ny = ( vx / n) * (p / 2)
    pico.set.pencil [color=cor, shape=[style=:fill]]
    pico.output.draw.poly [
        ['!', x=px1+nx, y=py1+ny], ['!', x=px2+nx, y=py2+ny],
        ['!', x=px2-nx, y=py2-ny], ['!', x=px1-nx, y=py1-ny],
    ]
    pico.output.draw.oval ['!', x=px1, y=py1, w=p, h=p]
    pico.output.draw.oval ['!', x=px2, y=py2, w=p, h=p]
}

;; TEXT

;; The font of a layer (the pencil is of each layer).
func fonte (path) {
    pico.set.pencil [text=[font=path, smooth=true]]
}

;; The width of a text of height `h`.
func largura (str, h) {
    val s = tostring(str)
    if #s == 0 => 0 => pico.get.text(['%', h=h], s).w
}

;; A text of height `h`, placed by the point (x,y) and the anchor `onde` of
;; its box (`:C`, `:N`, `:S`, `:W`, `:E`, ...).
func texto (str, x, y, h, cor, onde) {
    val s = tostring(str)
    if #s == 0 {
        return
    }
    pico.set.pencil [color=cor]
    pico.output.draw.text(s, ['%', x=x, y=y, h=h, anchor=onde])
}

;; IMAGES

;; An image, as a layer at the opacity `alpha` (half by default), and the
;; proportion of its width to its height.
func figura (path, alpha) {
    val d = pico.get.image(path)
    val l = pico.layer.image [path=path]
    val old = pico.set.layer(l)
    pico.set.effect [alpha=alpha || 128]
    pico.set.layer(old)
    [layer=l, r=d.w/d.h]
}

;; An image by its center, of height `h`.
func poe (img, x, y, h) {
    pico.output.draw.layer(img.layer, ['%', x=x, y=y, w=larg(h)*img.r, h=h, anchor=:C])
}
